---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Trust from '../components/sections/Trust.astro';
import SealedBlock from '../components/sections/SealedBlock.astro';
import Beliefs from '../components/sections/Beliefs.astro';
import Labs from '../components/sections/Labs.astro';
import Features from '../components/sections/Features.astro';
import Qol from '../components/sections/Qol.astro';
import Gaps from '../components/sections/Gaps.astro';
import Install from '../components/sections/Install.astro';

const rail = [
  ['hero', 'hero'],
  ['trust', 'trust'],
  ['sealed', 'sealed'],
  ['beliefs', 'beliefs'],
  ['labs', 'labs'],
  ['modes', 'modes'],
  ['tools', 'tools'],
  ['permissions', 'permissions'],
  ['agents', 'agents'],
  ['sessions', 'sessions'],
  ['providers', 'providers'],
  ['vulnetix', 'vulnetix'],
  ['qol', 'qol'],
  ['gaps', 'gaps'],
  ['install', 'install'],
] as const;
---

<Base
  title="Signet: a safer LLM coding harness"
  description="Signet is a safer LLM coding harness: sealed delimiters, a security classifier, fail-closed posture gates, a prompt library, a repo map, and role/mode determinism. Free and open source."
>
  <div class="flex w-full gap-8 px-4 py-8 sm:px-6 lg:gap-10 lg:px-10 lg:py-10">
    <aside class="status-rail w-52 shrink-0 flex-col justify-between xl:w-56" aria-label="Page sections">
      <div>
        <p class="mono text-sm font-bold text-vx-ink">▌ signet</p>
        <nav aria-label="On this page">
          <ul class="mt-6 space-y-1 list-none p-0">
            {rail.map(([id, label]) => (
              <li>
                <a
                  href={`#${id}`}
                  data-rail={id}
                  class="status-rail__item mono block text-sm text-vx-ink/70 no-underline hover:text-vx-ink"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="mono text-xs text-vx-ink/60">
        <p>mode: agent</p>
        <p>guardrails: on</p>
        <p>~12k / 200k</p>
      </div>
    </aside>

    <main class="min-w-0 flex-1 space-y-8">
      <Hero />
      <Trust />
      <SealedBlock />
      <Beliefs />
      <Labs />
      <Features />
      <Qol />
      <Gaps />
      <Install />
    </main>
  </div>
</Base>