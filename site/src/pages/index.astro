---
import Base from '../layouts/Base.astro';
import Intro from '../components/sections/Intro.astro';
import Trust from '../components/sections/Trust.astro';
import Classifier from '../components/sections/Classifier.astro';
import SealedBlock from '../components/sections/SealedBlock.astro';
import Beliefs from '../components/sections/Beliefs.astro';
import Labs from '../components/sections/Labs.astro';
import Features from '../components/sections/Features.astro';
import Kanban from '../components/sections/Kanban.astro';
import WebSessions from '../components/sections/WebSessions.astro';
import Extend from '../components/sections/Extend.astro';
import CLI from '../components/sections/CLI.astro';
import Qol from '../components/sections/Qol.astro';
import Install from '../components/sections/Install.astro';
import FAQ from '../components/sections/FAQ.astro';
import JumpNav from '../components/ui/JumpNav.astro';
import { sections } from '../lib/sections';
---

<Base
  title="Belai: a safer LLM coding harness"
  description="Belai is a safer LLM coding harness: sealed delimiters, a security classifier embedded in the default binary, fail-closed posture gates, supervised processes, a prompt library, a repo map, cross-agent session and memory search, model routing, token budgets, agent crews that take their work from a kanban board and whose acceptance gates the harness runs, dependency checks as the agent edits, twenty providers, an OS sandbox, hooks, skills, plugins, MCP servers, editor integration over ACP, OpenTelemetry export, and role/mode determinism. Free and open source."
>
  <header>
    <Intro />
  </header>

  <JumpNav />

  <div class="flex w-full gap-8 px-4 py-8 sm:px-6 lg:gap-10 lg:px-10 lg:py-10">
    <aside class="status-rail w-52 shrink-0 flex-col justify-between xl:w-56" aria-label="Page sections">
      <div>
        <p class="mono text-sm font-bold text-vx-ink">▌ belai</p>
        <nav aria-label="On this page">
          <ul class="mt-5 space-y-0.5 list-none p-0">
            {sections.map(([id, label], i) => (
              <li>
                <a
                  href={`#${id}`}
                  data-rail={id}
                  class="status-rail__item mono block text-sm text-vx-ink/70 no-underline hover:text-vx-ink"
                >
                  <span class="status-rail__num">{String(i + 1).padStart(2, '0')}</span>{label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <div class="mono text-xs text-vx-ink/60">
        <p>mode: agent</p>
        <p>guardrails: on</p>
        <p>rope: tight</p>
        <p>~12k / 200k</p>
      </div>
    </aside>

    <main class="min-w-0 flex-1">
      <Beliefs />
      <Trust />
      <Classifier />
      <SealedBlock />
      <Labs />
      <Features />
      <Kanban />
      <WebSessions />
      <Extend />
      <CLI />
      <Qol />
      <Install />
      <FAQ />
    </main>
  </div>
</Base>