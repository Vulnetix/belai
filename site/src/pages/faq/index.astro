---
import Base from '../../layouts/Base.astro';
import FAQ from '../../components/sections/FAQ.astro';
import JumpNav from '../../components/ui/JumpNav.astro';

const title = 'Belai FAQ: data, providers, safety and install';
const description =
  'Answers about what Belai sends off your machine, which providers it supports, what a cloned repository can change and how commands are fenced, plus install and update recipes, including how to remove the previous signet package name and clear Homebrew caches.';
---

<Base title={title} description={description}>
  <JumpNav title="faq" items={[['/#faq', 'back to site']]} />

  <div class="flex w-full gap-8 px-4 py-8 sm:px-6 lg:gap-10 lg:px-10 lg:py-10">
    <aside class="status-rail w-52 shrink-0 flex-col justify-between xl:w-56" aria-label="Page sections">
      <div>
        <p class="mono text-sm font-bold text-vx-ink">▌ belai / faq</p>
        <nav aria-label="On this page">
          <ul class="mt-6 space-y-1 list-none p-0">
            <li>
              <a href="/#faq" class="status-rail__item mono block text-sm text-vx-ink/70 no-underline hover:text-vx-ink">
                back to site
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="mono text-xs text-vx-ink/60">
        <p>mode: agent</p>
        <p>guardrails: on</p>
      </div>
    </aside>

    <main class="min-w-0 flex-1">
      <FAQ chapter={false} />
    </main>
  </div>
</Base>
