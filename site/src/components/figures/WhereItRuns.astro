---
// One session, two places to run it: your machine, or a Pix Sandbox. The
// Vulnetix console sits between them. Each machine mirrors its session to the
// console and takes web prompts and requests back. The console's sessions card
// is the ink gate: it is the one place a prompt from the web becomes a prompt.

const cols = [
  {
    label: 'YOUR MACHINE',
    x: 30,
    cards: [
      ['Belai in your terminal', 'the session you type in', 'plain'],
      ['belai rc', 'takes web requests', 'plain'],
      ['Your provider keys', 'stay on this machine', 'plain'],
    ],
  },
  {
    label: 'VULNETIX CONSOLE',
    x: 350,
    cards: [
      ['Sessions and fleet', 'follow, steer, assign', 'gate'],
      ['Kanban board', 'cards the crews work from', 'plain'],
      ['Audit log', 'chained, so edits show', 'plain'],
    ],
  },
  {
    label: 'PIX SANDBOX',
    x: 670,
    cards: [
      ['Belai in the sandbox', 'your repos and languages', 'plain'],
      ['belai rc, always on', 'day and night', 'plain'],
      ['Vulnetix AI Firewall', 'holds keys, checks calls', 'pass'],
    ],
  },
] as const;

const rowY = [56, 150, 244];
// Arrow pairs between neighbouring columns, rows one and two.
const pairs = [
  { x1: 260, x2: 360, top: ['mirror', 'prompts'], bottom: ['heartbeat', 'requests'] },
  { x1: 580, x2: 680, top: ['prompts', 'mirror'], bottom: ['requests', 'heartbeat'] },
];
---

<div class="mt-10 overflow-x-auto rounded-xl border border-vx-ink bg-vx-bone/30 p-4 md:p-6">
  <svg viewBox="0 0 960 340" class="h-auto w-full min-w-[640px]" fill="none" stroke="currentColor" stroke-width="1.5" role="img" aria-label="Three places. Your machine runs Belai in a terminal and belai rc, and keeps your provider keys. The Vulnetix console holds sessions, the kanban board and the audit log. A Pix Sandbox runs Belai and belai rc day and night behind the Vulnetix AI Firewall. Sessions mirror to the console, and web prompts and requests travel back to either machine.">
    <defs>
      <marker id="wr-ink" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="fill-vx-ink/60" stroke="none" /></marker>
    </defs>

    {cols.map((c, ci) => (
      <g>
        <rect x={c.x - 10} y="8" width="260" height="322" rx="12" class={ci === 2 ? 'fill-vx-mint/25' : 'fill-vx-bone/60'} stroke={ci === 1 ? 'currentColor' : 'none'} />
        <text x={c.x + 6} y="30" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/70" stroke="none">{c.label}</text>
      </g>
    ))}

    {pairs.map((p) => [0, 1].map((r) => (
      <g>
        <path d={`M${p.x1} ${rowY[r] + 20} H${p.x2 - 2}`} class="text-vx-ink/55" stroke="currentColor" marker-end="url(#wr-ink)" />
        <path d={`M${p.x2} ${rowY[r] + 44} H${p.x1 + 2}`} class="text-vx-ink/55" stroke="currentColor" marker-end="url(#wr-ink)" />
        <text x={(p.x1 + p.x2) / 2} y={rowY[r] + 12} text-anchor="middle" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink/70" stroke="none">{(r === 0 ? p.top : p.bottom)[0]}</text>
        <text x={(p.x1 + p.x2) / 2} y={rowY[r] + 60} text-anchor="middle" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink/70" stroke="none">{(r === 0 ? p.top : p.bottom)[1]}</text>
      </g>
    )))}

    {cols.map((c) => c.cards.map(([name, sub, kind], r) => (
      <g>
        <rect x={c.x + 10} y={rowY[r]} width="220" height="64" rx={kind === 'gate' ? 12 : 10} class={kind === 'gate' ? 'fill-vx-ink' : kind === 'pass' ? 'fill-vx-mint' : 'fill-vx-cream'} stroke={kind === 'plain' ? undefined : 'none'} />
        <text x={c.x + 120} y={rowY[r] + 28} text-anchor="middle" font-family="Geist, sans-serif" font-size="14" font-weight="700" class={kind === 'gate' ? 'fill-vx-cream' : ''} fill={kind === 'gate' ? undefined : 'currentColor'} stroke="none">{name}</text>
        <text x={c.x + 120} y={rowY[r] + 48} text-anchor="middle" font-family="Geist Mono, monospace" font-size="11" class={kind === 'gate' ? 'fill-vx-mint' : 'fill-vx-ink/75'} stroke="none">{sub}</text>
      </g>
    )))}
  </svg>
</div>
