---
// SectionBreak is the one device that separates home-page sections: a wide
// gap, then a length of rope with a figure-eight knot and the chapter label
// ("07 / 25 · modes"). It is the only place the rope appears, so the reader
// can tell a section break from a gap inside a section. SealedSection renders
// it above its frame, outside the sealed element, so no digest covers it.
import { chapterNumber, type Chapter } from '../../lib/sections';

interface Props {
  chapter: Chapter;
}

const { chapter } = Astro.props;
---

<div class="chapter" aria-hidden="true">
  <span class="chapter__rope"></span>
  <span class="chapter__mark">
    <svg class="chapter__knot" viewBox="0 0 28 18" width="28" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M14 9C10 2 2 2 2 9s8 7 12 0c4-7 12-7 12 0s-8 7-12 0Z" />
    </svg>
    <span class="chapter__label mono">{chapterNumber(chapter)} · {chapter.label}</span>
  </span>
  <span class="chapter__rope"></span>
</div>
