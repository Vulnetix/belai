---
// SectionHead opens a section: a large title on the left and the lead
// paragraph on the right. The lead is the slot.

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="grid gap-6 lg:grid-cols-12 lg:items-end">
  <div class="lg:col-span-7">
    <h2 class="text-4xl font-extrabold leading-tight tracking-tight text-vx-ink md:text-5xl">{title}</h2>
  </div>
  <div class="text-lg text-vx-ink/80 lg:col-span-5"><slot /></div>
</div>
