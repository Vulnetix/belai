---
// SectionHead opens a section: a large title and the lead paragraph. Side by
// side once the section body is wide enough for a readable lead, stacked
// below that. The lead is the slot.

import Surfaces from './Surfaces.astro';
import type { Surface } from '../../lib/surfaces';

interface Props {
  title: string;
  /** Where the section's feature works; see Surfaces.astro. */
  surfaces?: readonly Surface[];
}

const { title, surfaces } = Astro.props;
---

<div class="grid gap-6 @4xl:grid-cols-12 @4xl:items-end">
  <div class="@4xl:col-span-7">
    <h2 class="text-4xl font-extrabold leading-tight tracking-tight text-vx-ink md:text-5xl">{title}</h2>
    {surfaces && <Surfaces of={surfaces} />}
  </div>
  <div class="text-lg text-vx-ink/80 @4xl:col-span-5"><slot /></div>
</div>
