---
// Surfaces is the small row of markers that says where a feature works: the
// TUI, ACP, the CLI, a self-hosted machine, a Pix Sandbox, or only with
// Vulnetix. It is quiet on purpose, a hairline outline in small mono type, so
// it reads as a property of the heading and not as a label to act on. The
// markers always render in the order of lib/surfaces.ts.
import { surfaces, surfaceOrder, type Surface } from '../../lib/surfaces';

interface Props {
  of: readonly Surface[];
  class?: string;
}

const { of, class: cls = '' } = Astro.props;
const shown = surfaceOrder.filter((s) => of.includes(s));
---

{shown.length > 0 && (
  <ul class={`surfaces ${cls}`} aria-label="Works in">
    {shown.map((s) => (
      <li class="surface mono" title={surfaces[s]}>{s}</li>
    ))}
  </ul>
)}
