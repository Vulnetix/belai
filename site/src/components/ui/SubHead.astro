---
// SubHead is the heading row used inside a section: the title on the left
// and a short lead on the right, aligned to their shared baseline. The lead
// is the slot.

interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: cls = 'mt-20' } = Astro.props;
---

<div id={id} class={`grid scroll-mt-8 gap-6 lg:grid-cols-2 lg:items-end ${cls}`}>
  <h3 class="text-3xl font-bold tracking-tight text-vx-ink md:text-4xl">{title}</h3>
  <div class="text-vx-ink/80"><slot /></div>
</div>
