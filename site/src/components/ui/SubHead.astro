---
// SubHead is the heading row used inside a section: the title and a short
// lead. A light hairline and the sub-area gap mark it as a new sub-area; the
// heavy rope between sections (SectionBreak) is never used here. The lead is
// the slot.

interface Props {
  title: string;
  id?: string;
  class?: string;
}

const { title, id, class: cls = '' } = Astro.props;
---

<div id={id} class={`mt-sub scroll-mt-20 border-t border-vx-ink/15 pt-8 ${cls}`}>
  <div class="grid gap-4 @3xl:grid-cols-2 @3xl:items-end">
    <h3 class="text-3xl font-bold tracking-tight text-vx-ink md:text-4xl">{title}</h3>
    <div class="text-vx-ink/80"><slot /></div>
  </div>
</div>
