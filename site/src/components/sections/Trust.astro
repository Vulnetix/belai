---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Shot from '../ui/Shot.astro';
import chunked from '../../assets/concepts/chunked-classification.svg?raw';
import agentTurnShot from '../../assets/shots/agent-turn.svg';

// The trust pipeline drawn as two lanes: arbitrary content is sanitised and
// classified, shaped results are sanitised only. Dots travel the lanes; one
// in the upper lane is withheld. The motion stops under reduced motion.

const sealText =
  'Trust pipeline: every untrusted tool result is sanitized, classified, then passed on or blocked. Tools whose output format Belai controls are sanitized but not classified. Output kept out of the context is classified slice by slice as the model reads it while guardrails are on, and a WebFetch answer is written by a model with no tools and classified. The next section covers which engine classifies.';

const classified = [
  ['Bash', 'an arbitrary command'],
  ['WebFetch · WebSearch', 'text from off this machine'],
  ['Read', "a file's bytes"],
  ['Cat · Head · JQ · Sed …', 'native tools that print a file'],
  ['GH · Glab · Vulnetix', 'third-party repository text'],
  ['SearchSessions · SearchMemory', "other agents' transcripts"],
  ['KanbanSearch', 'items other sessions wrote'],
  ['Task · SubAgentLog', 'subagent and process output'],
  ['mcp__server__tool', 'MCP server results'],
  ['hooks · skills', 'text your extensions return'],
];

const shaped = [
  ['Grep', 'path:line:text'],
  ['Glob', 'a list of paths'],
  ['Write · Edit', 'a confirmation Belai wrote'],
  ['LS · Find · File · Cmp · Date …', 'fixed-argv metadata'],
];

const facts = [
  {
    title: 'Offloaded output is checked as it is read',
    body: 'A long result waits in memory behind a short preview. Each slice the model pulls in with `ReadResult` is classified at that moment while guardrails are on, so output saved while they were off is checked before the model sees it. A withheld result is never kept.',
  },
  {
    title: 'WebFetch answers from a model with no tools',
    body: 'When `WebFetch` answers a prompt, the model that reads the page has no tools, and its answer is classified before the agent sees it.',
  },
  {
    title: 'Requests say where they came from',
    body: 'Provider calls, `WebFetch` and `WebSearch` send `User-Agent: belai/<version>`, the `X-Belai-Session-Id` and `X-Belai-Tool` headers, and a W3C `traceparent`, so a gateway or proxy can tie every request back to its session and tool call.',
  },
];

const split = (s: string) => s.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));
---

<SealedSection label="trust" sealText={sealText} id="trust">
  <SectionHead title="Trust pipeline">
    Every untrusted tool result is sanitized, then classified, then either sent up the line to the model
    or blocked. Tools whose output has a format Belai controls are sanitized but not classified.
  </SectionHead>

  <div class="mt-10 overflow-hidden rounded-xl border border-vx-ink bg-vx-bone/30 p-4 md:p-6">
    <svg viewBox="0 0 960 330" class="trust-flow h-auto w-full" fill="none" stroke="currentColor" stroke-width="1.5" role="img" aria-label="Two lanes. Arbitrary content passes sanitize, then the classifier, then reaches the model or is withheld. Shaped results pass sanitize and reach the model.">
      <text x="16" y="28" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/60" stroke="none">ARBITRARY CONTENT</text>
      <text x="16" y="238" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/60" stroke="none">SHAPED RESULTS</text>

      <rect x="16" y="46" width="170" height="104" rx="10" class="fill-vx-cream" />
      <text x="32" y="76" font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">Bash · WebFetch</text>
      <text x="32" y="98" font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">Read · GH · MCP</text>
      <text x="32" y="120" font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">agent stores …</text>

      <rect x="16" y="254" width="170" height="56" rx="10" class="fill-vx-cream" />
      <text x="32" y="287" font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">Grep · Glob · Edit</text>

      <path d="M186 98 H650 C 700 98, 710 138, 760 138 H800" class="text-vx-ink/40" stroke="currentColor" stroke-dasharray="4 5" />
      <path d="M650 98 C 700 98, 710 60, 760 60 H800" class="stroke-vx-coral/60" stroke-dasharray="4 5" />
      <path d="M186 282 H440 C 560 282, 640 138, 800 138" class="text-vx-ink/40" stroke="currentColor" stroke-dasharray="4 5" />

      <rect x="250" y="66" width="130" height="64" rx="10" class="fill-vx-cream" />
      <text x="266" y="96" font-family="Geist, sans-serif" font-size="14" font-weight="700" fill="currentColor" stroke="none">sanitize</text>
      <text x="266" y="114" font-family="Geist Mono, monospace" font-size="10" class="fill-vx-mint-strong" stroke="none">strip markup</text>

      <rect x="250" y="250" width="130" height="64" rx="10" class="fill-vx-cream" />
      <text x="266" y="280" font-family="Geist, sans-serif" font-size="14" font-weight="700" fill="currentColor" stroke="none">sanitize</text>
      <text x="266" y="298" font-family="Geist Mono, monospace" font-size="10" class="fill-vx-mint-strong" stroke="none">strip markup</text>

      <rect x="480" y="56" width="170" height="84" rx="12" class="fill-vx-ink" stroke="none" />
      <text x="498" y="90" font-family="Geist, sans-serif" font-size="15" font-weight="700" class="fill-vx-cream" stroke="none">classifier</text>
      <text x="498" y="112" font-family="Geist Mono, monospace" font-size="10.5" class="fill-vx-mint" stroke="none">one sentinel token</text>

      <rect x="800" y="114" width="144" height="48" rx="10" class="fill-vx-mint" stroke="none" />
      <text x="816" y="144" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">to the model</text>
      <rect x="800" y="36" width="144" height="48" rx="10" class="fill-vx-coral/15 stroke-vx-coral" />
      <text x="816" y="66" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">withheld</text>

      <g class="trust-flow__dots" stroke="none">
        <circle r="6" class="fill-vx-mint-strong">
          <animateMotion dur="4.2s" repeatCount="indefinite" path="M186 98 H650 C 700 98, 710 138, 760 138 H800" />
        </circle>
        <circle r="6" class="fill-vx-coral">
          <animateMotion dur="4.2s" begin="-2.1s" repeatCount="indefinite" path="M186 98 H650 C 700 98, 710 60, 760 60 H800" />
        </circle>
        <circle r="6" class="fill-vx-ink">
          <animateMotion dur="3.4s" begin="-1s" repeatCount="indefinite" path="M186 282 H440 C 560 282, 640 138, 800 138" />
        </circle>
      </g>
    </svg>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-8">
      <p class="mono text-xs tracking-wider text-vx-ink/60">ALWAYS CLASSIFIED</p>
      <ul class="mt-3 grid list-none gap-x-6 p-0 sm:grid-cols-2">
        {classified.map(([tool, what]) => (
          <li class="border-b border-vx-ink/15 py-2.5 text-sm">
            <code class="mono block font-semibold">{tool}</code>
            <span class="text-vx-ink/70">{what}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="min-w-0 lg:col-span-4">
      <p class="mono text-xs tracking-wider text-vx-ink/60">SANITIZED ONLY</p>
      <ul class="mt-3 list-none p-0">
        {shaped.map(([tool, what]) => (
          <li class="border-b border-vx-ink/15 py-2.5 text-sm">
            <code class="mono block font-semibold">{tool}</code>
            <span class="text-vx-ink/70">{what}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-vx-ink/70">
        A Grep row from a file whose Read was withheld earlier in the session is withheld too.
      </p>
    </div>
  </div>

  <SubHead title="Checked wherever it enters">
    Content is classified at the point it reaches the model. That includes slices of stored output and
    answers that another model drew from a page.
  </SubHead>
  <div class="mt-8 grid gap-5 md:grid-cols-3">
    {facts.map((f) => (
      <article class="rounded-xl border border-vx-ink p-5">
        <h4 class="text-lg font-bold">{f.title}</h4>
        <p class="mt-2 text-sm text-vx-ink/80">
          {split(f.body).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}
        </p>
      </article>
    ))}
  </div>

  <SubHead title="Long documents, in chunks">
    Long documents are split into overlapping chunks, and the strictest chunk verdict applies to the
    whole document. The next section, <a href="#classifier" class="text-vx-ink underline decoration-vx-mint-strong underline-offset-4">the classifier</a>,
    covers which engine does the classifying and what happens when it can't decide.
  </SubHead>
  <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-center">
    <div class="rounded-xl border border-vx-ink p-2 lg:col-span-5" aria-hidden="true"><Fragment set:html={chunked} /></div>
    <Shot class="lg:col-span-7" src={agentTurnShot.src} alt="A streaming agent turn with a collapsed Bash preview" caption="streaming turn, collapsed Bash preview" />
  </div>
</SealedSection>
