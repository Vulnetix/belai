---
import CopyButton from '../ui/CopyButton.tsx';
import Walkthrough from '../ui/Walkthrough.astro';

// The intro is the one section that is not a sealed block: it runs the full
// width of the page on the mint ground, above the status rail, and plays on
// the name. A belayer holds the rope while the climber climbs.

const install = 'brew install vulnetix/tap/belai';

// The latest release tag, read at build time and refreshed in the browser
// (below) so the page never shows a stale version between deploys. Only a
// tag of the vX.Y.Z shape is ever shown; anything else leaves it blank.
const TAG = /^v\d+\.\d+\.\d+$/;
const RELEASES = 'https://api.github.com/repos/vulnetix/belai/releases/latest';
let latest = '';
try {
  const res = await fetch(RELEASES, { signal: AbortSignal.timeout(5000) });
  const tag = res.ok ? (await res.json()).tag_name : '';
  if (TAG.test(tag)) latest = tag;
} catch {
  // Offline build: the browser fills it in.
}

// Harness facts only, each one covered further down the page.
const facts = [
  ['license', 'Apache-2.0'],
  ['runs on', 'linux · darwin · windows'],
  ['classifier', 'in the binary'],
  ['guardrails', 'on by default'],
];
---

<section id="intro" class="intro relative overflow-hidden bg-vx-mint text-vx-ink" aria-labelledby="intro-title">
  <svg
    class="intro__rope pointer-events-none absolute inset-0 hidden h-full w-full lg:block"
    viewBox="0 0 1440 1000"
    preserveAspectRatio="xMaxYMid slice"
    aria-hidden="true"
  >
    <path
      pathLength="1"
      d="M1250 -10 C 1250 150, 1150 170, 1110 250 S 1190 420, 1100 620"
      fill="none"
      stroke="currentColor"
      stroke-width="7"
      stroke-linecap="round"
    ></path>
  </svg>

  <div class="relative px-4 pb-16 pt-6 sm:px-6 lg:px-10 lg:pb-24">
    <nav class="mono flex items-center justify-between gap-4 text-sm" aria-label="Site">
      <span>
        <span class="font-bold">▌ belai</span>
        <span class="ml-1 text-vx-ink/75" data-latest-version>{latest}</span>
      </span>
      <a href="https://github.com/vulnetix/belai" class="font-bold text-vx-ink no-underline hover:underline">github ↗</a>
    </nav>

    <div class="mt-14 grid gap-10 lg:mt-20 lg:grid-cols-12">
      <div class="lg:col-span-9">
        <p class="boot-stage boot-stage-1 mono text-sm font-medium">belay: to hold the rope for a harnessed climber</p>
        <h1 id="intro-title" class="boot-stage boot-stage-2 mt-6">
          <span class="block text-[3.5rem] font-bold leading-[0.86] tracking-[-0.05em] sm:text-8xl lg:text-[8.5rem] xl:text-[9.5rem]">
            You prompt.<br />We secure<br />the harness.
          </span>
          <span class="mt-8 block text-2xl font-semibold tracking-tight md:text-3xl">A safer AI agent fleet manager</span>
        </h1>
      </div>

      <dl class="boot-stage boot-stage-3 mono m-0 hidden flex-col items-end gap-1.5 text-sm lg:col-span-3 lg:flex lg:pt-24">
        {facts.map(([k, v]) => (
          <div class="flex gap-2">
            <dt class="text-vx-ink/70">{k}:</dt>
            <dd class="m-0">{v}</dd>
          </div>
        ))}
      </dl>

      <div class="boot-stage boot-stage-3 min-w-0 lg:col-span-5">
        <p class="prose-measure text-lg leading-relaxed">
          Most coding harnesses pass tool output straight to the model and leave safety to whatever you
          write into a <code class="mono">skills.md</code>. Belai does the checking in the harness itself. It
          seals the blocks of context it sends, runs a security classifier built into the binary over
          untrusted tool output, and blocks risky actions by default. It also keeps a prompt library and a
          repo map, and a mode you choose stays chosen. It is free and open source under Apache-2.0.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <code class="mono flex items-center gap-3 rounded-lg bg-vx-ink px-4 py-3 text-vx-mint">
            <span class="text-vx-cream/50" aria-hidden="true">$</span>{install}
          </code>
          <CopyButton
            value={install}
            label="copy install command"
            hoverClass="hover:bg-vx-ink hover:text-vx-mint"
            statusClass="text-vx-ink"
            client:load
          />
          <a href="#start" class="mono px-1 py-3 text-sm text-vx-ink underline underline-offset-4">other installs</a>
        </div>

        <dl class="mono m-0 mt-8 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-vx-ink/25 pt-6 text-sm lg:hidden">
          {facts.map(([k, v]) => (
            <div>
              <dt class="text-xs text-vx-ink/70">{k}</dt>
              <dd class="m-0 mt-0.5">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="boot-stage boot-stage-4 m-0 min-w-0 lg:col-span-7 lg:mt-4">
        <Walkthrough id="iFc-RGtsvlQ" title="the Belai walkthrough" class="intro__video" />
        <figcaption class="mono mt-8 text-xs text-vx-ink/75">belai, in motion</figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-latest-version]');
  if (el) {
    fetch('https://api.github.com/repos/vulnetix/belai/releases/latest')
      .then((r) => (r.ok ? r.json() : null))
      .then((r) => {
        const tag = r?.tag_name;
        if (typeof tag === 'string' && /^v\d+\.\d+\.\d+$/.test(tag)) el.textContent = tag;
      })
      .catch(() => {});
  }
</script>

<style>
  /* A hard offset shadow instead of a border: cream block, ink outline. */
  .intro :global(.intro__video) {
    box-shadow:
      10px 10px 0 var(--color-vx-cream),
      10px 10px 0 2px var(--color-vx-ink);
  }

  @media (min-width: 1024px) {
    .intro :global(.intro__video) {
      box-shadow:
        18px 18px 0 var(--color-vx-cream),
        18px 18px 0 2px var(--color-vx-ink);
    }
  }

  .intro__rope {
    color: var(--color-vx-ink);
  }

  .intro__rope path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: rope-pay-out 1400ms var(--ease-brand) 500ms forwards;
  }

  @keyframes rope-pay-out {
    to { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__rope path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>
