---
import SealedSection from '../seal/SealedSection.astro';
import CopyButton from '../ui/CopyButton.tsx';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';

interface Props {
  /** The home page numbers its sections; the standalone FAQ page does not. */
  chapter?: boolean;
}

const { chapter = true } = Astro.props;

const sealText =
  'FAQ: install, update and clean-up across Homebrew, Scoop, install.sh, GitHub Releases and source. Including variants, verification, and how to remove the previous name signet or reset stale package-manager state. About Belai: what leaves the machine, which providers work, whether it runs offline, what a cloned repository can change, how commands are fenced, what happens to a prompt injection in a file, what is free, which platforms and editors are supported, and how it runs unattended.';

// Product questions. Each answer is a list of paragraphs, and text between
// backticks renders as code.
const product: { q: string; a: string[] }[] = [
  {
    q: 'Does Belai send my code to anyone?',
    a: [
      'Belai sends your prompts, the files its tools read and the tool results to the model provider you choose. With a local model on Ollama or llama-server, that traffic stays on your machine.',
      'Belai sends no telemetry unless you set up OpenTelemetry export in your own settings, and that carries facts such as token counts, never content. Three more things leave the machine only when they are in use: session sync to the Vulnetix website, while the Vulnetix CLI is logged in (`/sync off` stops it), `WebFetch` and `WebSearch` when the model calls them, and a check for a newer release at startup (`update_check: false` turns it off).',
    ],
  },
  {
    q: 'Which models and providers can I use?',
    a: [
      'Twenty providers: OpenAI, Anthropic, Google Gemini, xAI, Mistral, DeepSeek, OpenRouter, Cloudflare Workers AI and AI Gateway, Hugging Face, Groq, Fireworks, Together, Moonshot, MiniMax, Alibaba, GitHub Copilot, Kiro, Ollama and llama-server. Any endpoint that speaks the OpenAI chat, OpenAI responses or Anthropic messages format works as a custom provider.',
      'With nothing configured, Belai starts on OpenRouter\'s free router. The Providers section has the details.',
    ],
  },
  {
    q: 'Does it work without an API key, or offline?',
    a: [
      'The security classifier ships in the default binary, so guardrails run with no provider and no key. The role manager\'s decisions, which Jev answers remotely, can run on Strands Decider-2B on your machine with no key: install strands-decider and pick it in /providers. For the agent itself, a local model on Ollama or llama-server needs no key and no network, and a self-hosted endpoint that needs no key is offered while it answers.',
    ],
  },
  {
    q: 'What can a repository I clone change about Belai?',
    a: [
      'A repository\'s settings can tighten Belai and cannot loosen it. They cannot define a provider, an MCP server, a hook, a firewall, a worker profile or a crew, and they can turn off the features that reach outside the session without being able to turn any of them on. Those come from your own settings.',
      'A directory Belai has not seen before asks for your trust before anything in it is read, and a path outside the session\'s folders is read only after you confirm its folder.',
    ],
  },
  {
    q: 'Can the model run any command it likes?',
    a: [
      'Commands go through `Bash`, which follows your permission rules and, where a backend exists, runs inside an operating-system sandbox. A deny rule is matched against every command on a line, including ones wrapped in `sudo`, `env`, `xargs` or `sh -c`. The common cloud and file tools run without a shell at all.',
    ],
  },
  {
    q: 'What happens if a file contains a prompt injection?',
    a: [
      'Anything the model did not write itself is untrusted text. Belai strips delimiter markup from it and, unless the tool\'s output has a shape Belai controls, the security classifier judges it before the model sees it. A flagged result is withheld, and Belai says so.',
    ],
  },
  {
    q: 'Is it free?',
    a: [
      'Belai is Apache-2.0. The Vulnetix scanners, the AI Firewall and the MCP server it works with are free for everyone.',
    ],
  },
  {
    q: 'Which platforms and editors does it support?',
    a: [
      'Linux, macOS and Windows, on amd64 and arm64. Zed, JetBrains IDEs, Neovim, Emacs and VS Code drive it over the Agent Client Protocol.',
    ],
  },
  {
    q: 'Can it run unattended?',
    a: [
      '`belai -prompt` answers one task and exits, which suits CI. For longer work, crews of worker agents take cards from the kanban board and open draft pull requests, each in its own worktree. Guardrails stay on for workers, an autonomous worker needs a pass budget, and the harness runs the acceptance gates itself.',
    ],
  },
];

const split = (t: string) => t.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));

const faqs = [
  {
    q: 'How do I install or update Belai?',
    steps: [
      { text: 'macOS / Linux with Homebrew:', cmd: 'brew install vulnetix/tap/belai' },
      { text: 'Windows with Scoop:', cmd: 'scoop bucket add vulnetix https://github.com/Vulnetix/scoop-bucket && scoop install belai' },
      { text: 'Any platform with the shell installer (checksum-verified):', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh' },
      { text: 'Update Homebrew installs:', cmd: 'brew update && brew upgrade --formula vulnetix/tap/belai' },
      { text: 'Update Scoop installs:', cmd: 'scoop update belai' },
      { text: 'Re-run install.sh to update a script install:', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh' },
    ],
  },
  {
    q: 'Which binary variant should I choose?',
    steps: [
      { text: 'Default: phase-1 guardrails and the speech model embedded (~77 MB, no API key needed):', cmd: 'belai-bert-guardrails (installed by Homebrew, Scoop and install.sh)' },
      { text: 'Add the local jailbreak gate (~517 MB total):', cmd: 'install.sh --variant bert-guardrails-jailbreak' },
      { text: 'Use the LLM sentinel only (about 24 MB, requires a provider, and voice input downloads its model on request):', cmd: 'install.sh --variant vanilla' },
      { text: 'No local classification at all (about 56 MB, voice input built in):', cmd: 'install.sh --variant no-classifier' },
    ],
  },
  {
    q: 'How do I use the install.sh script?',
    steps: [
      { text: 'Default install to ~/.local/bin:', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh' },
      { text: 'Install to a custom directory:', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh -s -- --install-dir ~/.local/bin' },
      { text: 'Install a specific version:', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh -s -- --version v0.1.1' },
      { text: 'Pick another variant:', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh -s -- --variant bert-guardrails-jailbreak' },
    ],
  },
  {
    q: 'How do I install or update on Windows?',
    steps: [
      { text: 'Add the Vulnetix bucket and install:', cmd: 'scoop bucket add vulnetix https://github.com/Vulnetix/scoop-bucket && scoop install belai' },
      { text: 'Update to the latest release:', cmd: 'scoop update belai' },
      { text: 'Check the installed version:', cmd: 'belai -version' },
    ],
  },
  {
    q: 'How do I install from GitHub Releases or build from source?',
    steps: [
      { text: 'Download a pre-built binary from the release assets:', cmd: 'https://github.com/vulnetix/belai/releases' },
      { text: 'Install the latest release with go:', cmd: 'go install github.com/vulnetix/belai/cmd/belai@latest' },
      { text: 'Build a development binary from a clone:', cmd: 'git clone https://github.com/vulnetix/belai && cd belai && go build ./cmd/belai' },
      { text: 'Build a stamped release binary with just:', cmd: 'git clone https://github.com/vulnetix/belai && cd belai && just build' },
    ],
  },
  {
    q: 'What if Homebrew fails or reports a stale formula?',
    steps: [
      { text: 'Make sure the Vulnetix tap is present:', cmd: 'brew tap vulnetix/tap' },
      { text: 'Force a fresh fetch of the tap metadata:', cmd: 'brew update --force' },
      { text: 'Reinstall directly from the tap:', cmd: 'brew install vulnetix/tap/belai' },
      { text: 'Clear caches and start over:', cmd: 'brew uninstall belai 2>/dev/null; brew cleanup -s belai' },
    ],
  },
  {
    q: 'I have an old install called `signet`. How do I remove it?',
    steps: [
      { text: 'Uninstall the previous package name if it is still present:', cmd: 'brew uninstall signet' },
      { text: 'Clean up any leftover signet cache:', cmd: 'brew cleanup -s signet' },
      { text: 'Remove the old tap alias if it is still listed:', cmd: 'brew untap vulnetix/tap/signet' },
      { text: 'Install Belai and verify the version:', cmd: 'brew install vulnetix/tap/belai && belai -version' },
    ],
  },
  {
    q: 'How do I fully reset the Homebrew side?',
    steps: [
      { text: 'Uninstall both names and clear caches:', cmd: 'brew uninstall belai signet 2>/dev/null; brew cleanup -s belai signet' },
      { text: 'Re-tap Vulnetix cleanly:', cmd: 'brew untap vulnetix/tap; brew tap vulnetix/tap' },
      { text: 'Install fresh and check the version:', cmd: 'brew install vulnetix/tap/belai && belai -version' },
    ],
  },
  {
    q: 'How do I verify the install worked?',
    steps: [
      { text: 'Print the version:', cmd: 'belai -version' },
      { text: 'Run a quick smoke test:', cmd: 'belai -detect-mode' },
      { text: 'Launch the TUI:', cmd: 'belai' },
    ],
  },
];
---

<SealedSection label="faq" sealText={sealText} id="faq" chapter={chapter}>
  <SectionHead title="Questions and answers">
    Answers about data, providers and safety, then recipes for installing, updating and cleaning up.
  </SectionHead>

  <div class="mt-head space-y-3">
    {product.map((item) => (
      <details class="group rounded-md border border-vx-ink/30">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 text-vx-ink hover:bg-vx-ink/[0.03]">
          <span class="font-semibold">{item.q}</span>
          <span class="mono text-vx-ink/70 transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="space-y-3 border-t border-vx-ink/30 p-4 pt-3">
          {item.a.map((para) => (
            <p class="text-vx-ink/85">{split(para).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}</p>
          ))}
        </div>
      </details>
    ))}
  </div>

  <SubHead id="faq-install" title="Install, update and clean-up">
    If something is left over from the previous <code class="mono">signet</code> package name, or Homebrew has
    a stale bottle, the recipes below walk through a clean recovery.
  </SubHead>

  <div class="mt-head space-y-3">
    {faqs.map((faq) => (
      <details class="group rounded-md border border-vx-ink/30">
        <summary class="flex cursor-pointer list-none items-center justify-between p-4 text-vx-ink hover:bg-vx-ink/[0.03]">
          <span class="font-semibold">{faq.q}</span>
          <span class="mono text-vx-ink/60 transition-transform group-open:rotate-180">▼</span>
        </summary>
        <div class="border-t border-vx-ink/30 p-4 pt-2">
          <ol class="list-none space-y-3 p-0">
            {faq.steps.map((step, sidx) => (
              <li>
                <p class="text-sm text-vx-ink/70">
                  {sidx + 1}. {step.text}
                </p>
                <div class="mt-2 flex flex-wrap items-center gap-3 rounded-md border border-vx-ink/20 bg-vx-ink/[0.02] p-3">
                  <code class="mono block overflow-x-auto text-sm text-vx-ink">{step.cmd}</code>
                  <CopyButton value={step.cmd} label="copy" client:load />
                </div>
              </li>
            ))}
          </ol>
        </div>
      </details>
    ))}
  </div>

  <p class="prose-measure mt-8 text-vx-ink/80">
    Still stuck? Open an issue on{' '}
    <a class="underline" href="https://github.com/vulnetix/belai">github.com/vulnetix/belai</a>{' '}
    and include <code class="mono">belai -version</code>, the install method you
    used, and any platform or package-manager diagnostics (for example{' '}
    <code class="mono">brew config</code> and <code class="mono">brew doctor</code>{' '}
    on macOS/Linux, or <code class="mono">scoop config</code> on Windows).
  </p>
</SealedSection>
