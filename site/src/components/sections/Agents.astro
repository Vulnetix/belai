  <!-- Crews and your own -->
  <SubHead id="profiles" title="Built-in crews and your own">
    Two crews ship with Belai, each member with a name and a way of writing its report. Your own crews
    are a Markdown profile away.
  </SubHead>
  <CrewLanes />
  <div class="mt-sub grid gap-10 @6xl:grid-cols-2 @6xl:items-start">
    <div class="min-w-0">
      {crews.map((c, ci) => (
        <div class={ci === 0 ? '' : 'mt-8'}>
