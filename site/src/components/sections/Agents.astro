---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Walkthrough from '../ui/Walkthrough.astro';
import Limits from '../ui/Limits.astro';
import CopyButton from '../ui/CopyButton.tsx';
import CrewLanes from '../figures/CrewLanes.astro';
import rubberDuck from '../../assets/pix/personas/8a28c058-0f9e-5320-a948-f2b651f08874.svg?url';
import kremvax from '../../assets/pix/personas/3e8f176f-1538-5d79-b2c7-2eb35edfe989.svg?url';
import darkAvenger from '../../assets/pix/personas/52f09d1b-981d-59e9-b770-2eec1e628b49.svg?url';
import juniperTallis from '../../assets/pix/personas/2c302f2e-3661-5878-81af-495e448f910f.svg?url';
import odoBrannigan from '../../assets/pix/personas/85d6dca1-af97-5646-9e64-a704a4677ce0.svg?url';
import isadoraPell from '../../assets/pix/personas/47b621eb-90fd-53d0-9127-c28e09c2d120.svg?url';

// One section for every agent Belai runs besides the session: read-only
// subagents, background agents and crews of kanban workers. It is laid out as
// a ladder: each kind can change more than the one before it, and has stricter limits.

const docBase = 'https://github.com/Vulnetix/belai/blob/main/docs/';

const sealText =
  'Agents: helpers, background agents, workers and crews. Helpers (f8) split a question across read-only agents that run at once, stop after two to five rounds and report path:line findings. Background agents (/agent) are saved profiles with their own prompt, model, mode and tool list that run beside the session. Workers (belai agent start) are processes that claim items off the kanban board, alone or in a crew, work each on its own git worktree and branch inside the OS sandbox, push only through PublishBranch and open a draft pull request. The harness claims items, the item text is classified, settings come from the trusted repository root, and a worker that cannot ask blocks the item. belai:delivery runs a scout, two builders and a reviewer; belai:security a vulnerability scout, two patchers and a verifier. Both crews run once per repository and have no daily limit. The delivery crew runs your test suites once for the current commit and files what they show, as failing suites, thin coverage, untested packages, property tests, fixtures, contract tests, mutation testing and docs that disagree with the code, as tasks: a clear, concise task goes straight to Backlog for a builder, and one that needs you to confirm or split it waits in Review. Launching it again on the same commit adds nothing the board already has. Each task carries acceptance gates that name a test suite the harness detected, never a command. The harness runs them on the builder branch and again on the reviewer branch, a run that tested nothing is not a pass, and a card is done only when they pass, with the reviewer deciding the gates no test can observe. A request is split into clauses, and any clause no task covers gets a gap card. The security crew and scans only when no artefact in .vulnetix records the current commit. It files one card per finding, patchers fix them or report a false positive, no known fix or a need for a person, and the verifier checks each claim itself and has the harness write an OpenVEX file for the verdict. A profile can declare facts: the AWS role, account and region an agent works in, a Terraform directory, a Kubernetes context. The cloud tools read them, so a crew points at the right place without each prompt repeating it. A role the profile lists is assumed without a prompt, any other role asks you, and its temporary credentials stay in memory and reach only the AWS and Terraform commands. With belai rc running, the website sets schedules for workers, keeps a library of backed-up profiles with versions you can rewind and install on a host, and asks the host to draw a customised Pix for an agent. Autonomous work you can sign off on, ten promises each backed by a mechanism: the harness decides when a task is done by running acceptance gates, the harness claims work in one locked write, git runs layered inside the OS sandbox, a vulnerability finding is scanned, re-scanned and verified by the harness, a request is split into clauses and an uncovered clause gets a gap card, text another agent wrote is classified, a hash-chained audit records facts, a host pulls its requests and re-checks each one, budgets and handoff caps stop a runaway, and any provider or a local model can be used. Gates are references to a detected suite, never a command; a regression against the base commit counts; manual gates go to the reviewer. The Vulnetix console shows what needs a person, merges a crew into one thread with a group message, previews the flow when a card is assigned, pins a card to a host, assigns it to a person by email, pauses and resumes workers, keeps profile versions, draws avatars, verifies the audit chain and charts usage.';

type Step = {
  n: string;
  name: string;
  key: string;
  lead: string;
  facts: Record<string, string>;
};

const rows = ['Tools', 'Writes to', 'Runs', 'Stops at', 'When it would ask', 'Hands back'] as const;

const steps: Step[] = [
  {
    n: '01',
    name: 'Helpers',
    key: 'f8',
    lead: 'Several read-only helpers work on parts of one question at the same time and report back to your session.',
    facts: {
      Tools: 'Read-only: Read, Grep, Glob and the native readers',
      'Writes to': 'Nothing',
      Runs: 'Inside your turn, side by side',
      'Stops at': 'Two to five rounds, then one report with no tools',
      'When it would ask': 'It is told to carry on without asking',
      'Hands back': 'One path:line finding per line, 6 KiB at most',
    },
  },
  {
    n: '02',
    name: 'Background agents',
    key: '/agent',
    lead: 'A saved profile with its own prompt, model and tools. It runs beside your session once, on a loop, on a schedule or when a condition holds.',
    facts: {
      Tools: "The profile's list, or every tool when it lists none",
      'Writes to': 'Your working tree, under the permission rules',
      Runs: 'Beside your session, in its own pool slot',
      'Stops at': 'The end of its run, or max_iterations on a loop',
      'When it would ask': 'Supervised: it asks you. Autonomous: the rules decide',
      'Hands back': 'A report in your session',
    },
  },
  {
    n: '03',
    name: 'Workers and crews',
    key: 'belai agent start',
    lead: 'Worker processes that take items from the kanban board and work on each one in a branch of its own. A builder opens a draft pull request and a reviewer checks it. When nobody has filed anything, the scout goes looking for work and files it into Review for you to confirm.',
    facts: {
      Tools: "The profile's list, plus KanbanHandoff and PublishBranch",
      'Writes to': 'Its own worktree and branch, belai/K-xxxxxx/a1, outside the repository',
      Runs: 'As a detached process that outlives your terminal',
      'Stops at': 'Its pass budget, a lost lease, or max_attempts failures, which block the item',
      'When it would ask': 'It blocks the item with a note for you to clear',
      'Hands back': 'A draft pull request and notes on the item. If its worktree cannot be set up, it finds out why, read-only, and notes the cause',
    },
  },
];

// Ten promises about any unattended agent. Each body is a mechanism in this
// repository, so a reader can check it. Nothing here describes another product.
const promises: [string, string][] = [
  ['Done means the tests passed', 'After each turn the harness runs the acceptance gates on the card and the exit code decides. A run that tested nothing is not a pass, and a reviewer who approves cannot overrule a failing gate.'],
  ['Two workers never take the same card', 'Every claim is one locked write to the board. No tool lets a model claim an item, move a card or change a lease, so the harness stays in charge of who works on what.'],
  ['Your git history stays yours', 'An agent commits on a branch of its own. Git runs in the OS sandbox with your config, hooks, index and every other ref read-only, new objects go to a private store, and one tool pushes, to one branch.'],
  ['Every vulnerability ends in a verdict', 'The harness decides whether a scan ran. Each patcher fix is re-scanned after every round, a separate verifier re-runs the scanner, and the harness writes the OpenVEX file that records the verdict.'],
  ['Every part of your request gets tracked', 'A request is split into at most twelve clauses. Every handoff covers one, and a clause no task covers gets a gap card, filed by the harness from ids alone.'],
  ['Text from other agents is checked before it is read', 'Card text, lessons, handoffs and setup failures all pass the security classifier before any model reads them. A withheld card is blocked, and no worker takes it.'],
  ['Every action leaves a record you can verify', 'With sync on, a hash-chained audit records claims, commits, gate results and VEX files from fixed fields, never from prompts or output. The Vulnetix server recomputes the chain and flags a break.'],
  ['Steer a crew from the website', 'A host pulls its own requests and checks each one again. There is no inbound port, and the website cannot set a claim, a model, a posture or a permission. A message to a running worker needs sync.remote_prompts and is admitted like typed steering.'],
  ['A runaway has a ceiling', 'No worker starts with guardrails off, and an autonomous one refuses to start without a pass budget, or with Bash and no working sandbox. Each item has pass, token and wall-clock budgets, handoffs stop at five per item and six hops, and a crew runs once per repository.'],
  ['Bring the model you already use', 'Any provider Belai supports, or a model on your machine. A profile picks the provider, model and effort for the roles it runs, and the security classifier ships in the binary with no provider key to set up.'],
];

const assurance: [string, string][] = [
  ['A gate is a reference', 'A gate names a test suite the harness detected and, for Go, a package directory and a test name. It never holds a command: the harness builds the argv from its own table and runs it without a shell.'],
  ['The exit code decides', 'The harness runs the gates on the builder branch and again on the reviewer branch, in the OS sandbox with a scrubbed environment. A run that tested nothing is not a pass.'],
  ['Manual gates go to the reviewer', 'A gate no test can observe is decided by the reviewer with `KanbanGate`. Manual gates reset to unmet before each review, and an abandoned one blocks the card for a person.'],
  ['Regressions count', 'The harness compares a branch with the quality record of its base commit, so a branch cannot pass by breaking a suite that passed before.'],
  ['Every clause is tracked', 'A request becomes at most twelve clauses, and the `request_coverage` job also files a gap card when the tasks look unlikely to finish the request.'],
  ['Clear work goes straight on', 'A short title, a body of the right size and one to five gates send a task to Backlog for a builder. Anything else waits in Review for you, and a doubt can send a card to Review but never skip it.'],
];

const control: [string, string][] = [
  ['What needs you', 'Overview opens on what waits for a person: open questions, cards to confirm and lapsed claims, with the working and done-today counts and the free worker slots.'],
  ['One crew, one thread', 'Crew merges every live worker\'s transcript into one thread, and each line shows the profile hash, model and effort it ran under. A group message steers every live worker at its next pass boundary.'],
  ['Assign with a preview', 'The Assign sheet shows who works each stage and what happens on a failure before you file the card. It can pin a card to a host, start a worker there, or assign the card to a person, who gets a short email with the card id and a link and none of the card\'s text.'],
  ['An audit you can verify', 'The Audit tab filters by vulnerability, card, agent, repository and event kind, and Verify chain re-walks every stored hash, so an edited or missing event shows.'],
  ['Pause between cards', 'A pause is an empty marker file that the worker checks between cards, so no turn is cut off. Set it from the CLI, the TUI or the Hosts page.'],
  ['Why a worker idled', 'Its log says what it looks for and when nothing matched. With remote control on, Belai → Agents and Belai → Hosts show each worker, why it stopped and its last log lines, startup errors included.'],
  ['Schedules', 'While belai rc runs, it starts a worker on a cron you set, in a directory the host offers, through `belai agent start -drain`. Trust, preflight and the worker cap still apply, and a run is recorded before it fires.'],
  ['Profiles with history', 'A profile backs up to the library as versions you can rewind, and installs on another host from the website after the host validates it as a profile. The Agent Builder drafts every field from one sentence.'],
  ['A face of its own', 'Give an agent a name, colours and a personality, and your host draws its Pix with your main model. Belai admits only an image made of plain shapes and gradients, so a drawing cannot carry a script or fetch anything.'],
  ['Usage over time', 'Analytics charts tokens, models, tools, turns and time over 7, 30 or 90 days, and feeds the plan limits, pace and runway each host reports.'],
];

const quickstart = `belai kanban add "Add a CONTRIBUTING.md" -label build
belai agent start -crew belai:delivery -trust-dir
belai agent ps; belai kanban list
belai agent stop -all`;

// The board at the moment the reviewer took the item. Each column names the
// crew member that claims from it.
const board = [
  { list: 'backlog', swatch: 'bg-vx-ink/40', note: '12:17 filed with #build', claims: '#scout', who: 'scout ×1' },
  { list: 'in progress', swatch: 'bg-vx-mint-strong', note: '12:20 claimed by the builder · 12:27 PR opened', claims: '#build', who: 'builder ×2' },
  { list: 'review', swatch: 'bg-vx-sand-amber', note: '', claims: '#needs-review', who: 'reviewer ×1' },
  { list: 'done + PR', swatch: 'bg-vx-mint', note: 'approved work lands here, as a draft PR', claims: 'merges it', who: 'you' },
];

// Recorded from a real run on this repository with the released v0.57.2
// binary. Keep it truthful: it quotes the item's history.
const run = [
  ['12:17', 'added to backlog', '#build', 'belai kanban add'],
  ['12:20', 'backlog → in_progress', 'claimed by belai:builder', 'harness'],
  ['12:27', 'note', 'draft pull request opened: Vulnetix/belai#6', 'PublishBranch'],
  ['12:28', 'in_progress → review', 'completed in 2 passes; 1 file changed on belai/K-507600/a1', 'harness'],
  ['12:29', 'review → in_progress', 'claimed by belai:reviewer', 'harness'],
];

const fences = [
  ['The harness claims', 'A claim is one locked write to the board, so two workers never hold one item. A lease that lapses, because a worker crashed, returns it.'],
  ['Item text is classified', 'The item reaches the model as a classified attachment, kept apart from the prompt and the directives. A withheld item is blocked, and no worker takes it.'],
  ['Its own branch only', 'It commits inside the OS sandbox. Your config, hooks, index, objects and every other ref stay read-only.'],
  ['One way to push', 'PublishBranch pushes that branch to a GitHub or GitLab origin and opens a draft PR. git push, gh pr merge and git config are denied.'],
  ['Settings from the root', 'Trust, settings and credentials are read from your repository root, so an agent cannot plant them in a worktree for the next one.'],
  ['Refuses to start', 'No worker runs with guardrails off. An autonomous one needs a pass budget; one with Bash needs a working OS sandbox.'],
  ['Stops when the board is dry', 'A worker with nothing to claim, and no crew mate still working, waits two polls and exits, freeing its slot. Pass -stay to keep one waiting. A worker whose profile has its own schedule stays, and one started from a stored schedule runs with -drain and exits when the board is dry.'],
  ['Test sweeps on HEAD', 'Each time the delivery crew starts, the harness runs your detected test suites once for the current commit and files what they show as work for the scout: failing suites, thin coverage, untested packages, property tests, fixtures, contract tests and mutation testing. Launching it again on the same commit adds nothing the board already has.'],
];

// Each built-in member has a persona (internal/agentprofile/builtin): a display
// name, a palette whose first colour borders the Pix, and a drawing. A test in
// the Belai repository checks these names, colours and files against the profiles.
type Member = { role: string; n: number; name: string; colour: string; face: string; line: string };

const crews: { name: string; what: string; members: Member[] }[] = [
  {
    name: 'belai:delivery',
    what: 'a request, or a test run on HEAD → reviewed branches',
    members: [
      { role: 'scout', n: 1, name: 'Juniper Tallis', colour: '#2f8f5b', face: juniperTallis, line: 'Writes the survey: what is where, and small tasks for the builders.' },
      { role: 'builder', n: 2, name: 'Odo Brannigan', colour: '#d9732a', face: odoBrannigan, line: 'Says what was built and which check proves it.' },
      { role: 'reviewer', n: 1, name: 'Isadora Pell', colour: '#8a3a6b', face: isadoraPell, line: 'Cites the line, says why it matters and separates must-fix from nit.' },
    ],
  },
  {
    name: 'belai:security',
    what: 'a review of HEAD → verified fixes and a VEX for every verdict',
    members: [
      { role: 'vuln-scout', n: 1, name: 'Rubber Duck', colour: '#f2c12e', face: rubberDuck, line: 'Talks each finding through out loud, then says which are real.' },
      { role: 'patcher', n: 2, name: 'Kremvax', colour: '#b3262e', face: kremvax, line: 'Reports in short numbered bulletins, status word first.' },
      { role: 'verifier', n: 1, name: 'Dark Avenger', colour: '#5b2d91', face: darkAvenger, line: 'Argues the attacker\'s case against every fix before accepting it.' },
    ],
  },
];

const profile = `---
name: docs-writer
description: Writes and updates documentation items
mode: worker
autonomy: autonomous
tools: [Read, Grep, Glob, Edit, Write, Bash]
facts: {environment: staging, owner: docs-team}
kanban:
  labels: [docs]
  on_success: {list: review, labels: [needs-review]}
  handoff_to: [belai:builder]
  max_attempts: 3
workspace: {isolation: worktree, publish: agent}
budget: {max_passes_per_item: 6, max_wall_per_item: 30m}
memory: {enabled: true}
---
You document one kanban item per turn. Read the code it
names, write the docs, check every link, commit on your
branch, then PublishBranch with what you changed.`;

// Code-shaped fact values render in mono.
const codeish = /^(Read|Grep|Glob|KanbanHandoff|PublishBranch|max_iterations|max_attempts|path:line|belai\/K-xxxxxx\/a1)$/;
const parts = (s: string) => s.split(/(Read(?=,)|Grep(?=,)|Glob|KanbanHandoff|PublishBranch|max_iterations|max_attempts|path:line|belai\/K-xxxxxx\/a1)/);
---

<SealedSection label="agents" sealText={sealText} id="agents">
  <!-- The ladder -->
  <SectionHead title="Agents and crews" surfaces={['tui', 'cli', 'self-hosted', 'pix sandbox']}>
      Besides the session you type in, Belai can run three kinds of agent. Each kind can change more
      than the one before it, and has stricter limits on what it can reach. At the top of the ladder a
      crew of workers takes work from a board, and the harness claims it, runs the checks and decides
      when it is done.
    </SectionHead>

  <figure class="mt-10 m-0">
    <Walkthrough id="ubjrP7jpims" title="autonomous agents and crews" />
    <figcaption class="mono mt-3 text-xs text-vx-ink/75">agents and crews, in motion</figcaption>
  </figure>

  <ol class="mt-10 grid list-none gap-5 p-0 @3xl:grid-cols-3">
    {steps.map((s, i) => {
      const dark = i === 2;
      return (
        <li class={`flex flex-col gap-4 rounded-xl border border-vx-ink p-6 ${dark ? 'bg-vx-ink text-vx-cream' : ''}`}>
          <div class="flex items-center justify-between">
            <span class={`mono text-sm ${dark ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{s.n}</span>
            <kbd class={`mono rounded-md border border-b-[3px] px-2 py-0.5 text-sm ${dark ? 'border-vx-mint text-vx-mint' : 'border-vx-ink'}`}>{s.key}</kbd>
          </div>
          {i === 0 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="30" cy="55" r="11" fill="currentColor" />
              <path d="M41 55 C 90 55, 100 20, 150 20 M41 55 L150 55 M41 55 C 90 55, 100 90, 150 90" />
              <rect x="150" y="10" width="46" height="20" rx="4" class="fill-vx-bone" />
              <rect x="150" y="45" width="46" height="20" rx="4" class="fill-vx-bone" />
              <rect x="150" y="80" width="46" height="20" rx="4" class="fill-vx-bone" />
              <path d="M196 20 C 240 20, 240 55, 280 55 M196 55 L280 55 M196 90 C 240 90, 240 55, 280 55" stroke-dasharray="3 4" />
              <circle cx="290" cy="55" r="11" class="fill-vx-mint" />
            </svg>
          )}
          {i === 1 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="14" y="30" width="128" height="50" rx="8" class="fill-vx-bone" />
              <line x1="30" y1="48" x2="110" y2="48" />
              <line x1="30" y1="62" x2="90" y2="62" />
              <path d="M170 55 A 55 38 0 1 1 280 55 A 55 38 0 1 1 170 55" stroke-dasharray="3 4" />
              <path d="M272 40 l9 15 l-15 3" stroke-linejoin="round" />
              <circle cx="225" cy="55" r="12" class="fill-vx-mint-strong" stroke="none" />
            </svg>
          )}
          {i === 2 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full text-vx-mint" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <g class="text-vx-cream/30" stroke="currentColor">
                <rect x="4" y="8" width="70" height="94" rx="6" />
                <rect x="84" y="8" width="70" height="94" rx="6" />
                <rect x="164" y="8" width="70" height="94" rx="6" />
                <rect x="244" y="8" width="72" height="94" rx="6" />
              </g>
              <rect x="12" y="20" width="54" height="16" rx="3" stroke-dasharray="3 3" />
              <rect x="92" y="44" width="54" height="16" rx="3" stroke-dasharray="3 3" />
              <rect x="172" y="68" width="54" height="16" rx="3" class="fill-vx-sand-amber" stroke="none" />
              <path d="M66 28 L92 52 M146 52 L172 76" stroke-dasharray="2 3" />
              <text x="266" y="60" font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">PR</text>
            </svg>
          )}
          <h3 class="text-2xl font-bold">{s.name}</h3>
          <p class={dark ? 'text-vx-cream/85' : 'text-vx-ink/80'}>{s.lead}</p>
        </li>
      );
    })}
  </ol>
  <div class="mono mt-3 hidden items-center gap-4 text-sm @4xl:flex" aria-hidden="true">
    <span class="text-vx-ink/60">reads and reports</span>
    <span class="h-px flex-1 bg-vx-ink"></span><span class="-ml-3">▸</span>
    <span>writes and pushes on its own</span>
  </div>

  <!-- What changes on each step -->
  <SubHead title="How the three kinds differ">
      All three follow your permission rules and the guardrails switch, and the security classifier
      checks everything they read. The table shows what else differs.
    </SubHead>

  <details class="deep deep--wide">
    <summary>Compare tools, write access, limits and hand-back</summary>
    <div class="deep__body">
  <table class="mt-4 hidden w-full border-collapse text-left @3xl:table">
    <thead>
      <tr class="border-b-2 border-vx-ink">
        <th scope="col" class="w-[16%] pb-4"><span class="sr-only">Property</span></th>
        {steps.map((s, i) => (
          <th scope="col" class={`px-5 pb-4 pt-3 text-lg font-bold ${i === 2 ? 'bg-vx-sand' : ''}`}>
            <span class="mono text-xs font-medium text-vx-ink/60">{s.n} </span>{s.name}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr class="border-b border-vx-ink/20 last:border-b-0">
          <th scope="row" class="py-5 pr-5 align-top font-semibold">{r}</th>
          {steps.map((s, i) => (
            <td class={`px-5 py-5 align-top text-vx-ink/85 ${i === 2 ? 'bg-vx-sand/40' : ''}`}>
              {parts(s.facts[r]).map((p) => (codeish.test(p) ? <code class="mono text-[0.92em]">{p}</code> : p))}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>

  <div class="mt-4 grid gap-4 @3xl:hidden">
    {steps.map((s, i) => (
      <article class={`rounded-xl border border-vx-ink p-5 ${i === 2 ? 'bg-vx-ink text-vx-cream' : ''}`}>
        <h4 class="text-xl font-bold"><span class={`mono text-xs font-medium ${i === 2 ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{s.n} </span>{s.name}</h4>
        <dl class={`mt-4 grid grid-cols-[6.5rem_minmax(0,1fr)] gap-x-3 gap-y-2 border-t pt-4 text-sm ${i === 2 ? 'border-vx-cream/20' : 'border-vx-ink/20'}`}>
          {rows.map((r) => (
            <>
              <dt class={i === 2 ? 'text-vx-cream/70' : 'text-vx-ink/60'}>{r}</dt>
              <dd class="m-0">{s.facts[r]}</dd>
            </>
          ))}
        </dl>
      </article>
    ))}
  </div>
    </div>
  </details>

  <!-- Ten promises -->
  <SubHead id="sign-off" title="Autonomous work you can sign off on">
    Leave a crew running and read the result when you are back. These ten things hold while you are away,
    and each rests on a mechanism you can read in the source.
  </SubHead>
  <ol class="mt-head list-none p-0">
    {promises.map(([q, a], i) => (
      <li class="grid gap-x-10 gap-y-2 border-b border-vx-ink/20 py-6 first:border-t first:border-vx-ink/60 @3xl:grid-cols-[17rem_minmax(0,1fr)]">
        <h4 class="text-lg font-bold leading-snug"><span class="mono mr-2 text-sm font-medium text-vx-mint-strong">{String(i + 1).padStart(2, '0')}</span>{q}</h4>
        <p class="text-vx-ink/85">{a}</p>
      </li>
    ))}
  </ol>

  <!-- Done is decided by the harness -->
  <SubHead id="assurance" title="Gates decide when a card is done">
    A card carries acceptance gates. After each turn the harness runs them and routes the card by what they return.
  </SubHead>
  <Limits items={assurance} class="mt-head" />

  <!-- A crew at work -->
