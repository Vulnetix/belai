---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Ladder from '../ui/Ladder.astro';
import Limits from '../ui/Limits.astro';

const sealText =
  'Memory: SearchSessions, ReadSession and SearchMemory read the transcripts and memory files of other coding agents on this machine from a fixed registry, take no path argument, cite every hit, and always classify. Each turn also carries harness-computed git and forge facts and the read index, and plan and goal turns prefetch the instruction and changed files through a classified Read. Knowledge: beside the usual Grep, Glob and Read answer, a model gets passages that resemble its query from the documents an agent profile lists and from the scanner output in .vulnetix and the files attached with @. Every chunk is sanitized and admitted by the security classifier when it is indexed, so a search calls no model, the search is pure Go with no embedding model or service, a deny rule hides a source path, and /knowledge shows what is indexed.';

const tools = [
  { n: '01', name: 'SearchSessions', key: 'regex', lead: 'Searches past sessions with a regular expression, by default only those recorded in the current project. With `prompts_only`, only prompt history is searched, which is faster.' },
  { n: '02', name: 'ReadSession', key: 'around a hit', lead: 'Reads the turns around a hit, so the model sees what was asked and what the agent did about it.' },
  { n: '03', name: 'SearchMemory', key: 'rules · memory', lead: "Searches memory and rules files such as `AGENTS.md`, `CLAUDE.md` and `.cursorrules`, each agent's memory folder, and Belai's saved goals, prompts and plans." },
];

const agents = ['Belai', 'Claude Code', 'Codex', 'pi', 'Goose', 'opencode', 'Copilot in VS Code', 'Copilot CLI', 'Antigravity'];
const needsSqlite = new Set(['Goose', 'opencode']);

const knowledge: [string, string][] = [
  ['Two kinds of knowledge', 'Profile knowledge is the documents an agent profile lists, such as a handbook, a style guide or runbooks. Project knowledge is the scanner output in `.vulnetix` and the files you attach with `@`.'],
  ['Through the tools it already uses', 'A model\'s own `Grep`, `Glob` and `Read` calls add labelled `kb+` rows after the filesystem result. A harness read, such as an `@` attachment, gets the filesystem alone.'],
  ['Classified once, when indexed', 'Every chunk is sanitized and admitted by the security classifier at ingestion, and a flagged chunk is never stored. A search then calls no model.'],
  ['Runs in the process', 'The search is pure Go, with no embedding model to download, no service to call and no cgo, so it works offline in every release build.'],
  ['Permissions still apply', 'A deny rule on a document\'s source path hides it from search and listing, and a profile whose tools leave out `Grep` has no knowledge through `Grep`.'],
  ['See what is indexed', '`/knowledge` opens the indexes read-only for this project, every project or the agents, with each document\'s type, labels and topics, and searches them as a model\'s tools would.'],
];

const hit = [
  ['agent', 'the agent that wrote it'],
  ['session', 'which session'],
  ['turn · role', 'where in it, and who'],
  ['time', 'when'],
  ['project', 'which repository'],
];

const knows = [
  {
    title: 'Git and forge facts',
    body: 'Every turn carries the upstream with ahead and behind counts, the worktrees, and, when `gh` or `glab` answers, the PR or MR number, its state and CI counts. The facts refresh in the background and a turn never waits for the network. PR titles, check names and other forge text are left out; the model reads those through `GH` or `Glab`, which classify.',
  },
  {
    title: 'Read index',
    body: 'When the model reads an unchanged file again and the earlier copy is still in the conversation, it gets a short note instead: the path, the lines, the size and the git blob id. The index stores those facts, never file contents. Any edit, a changed timestamp or a file whose read was withheld sends the next read to disk and through the classifier as usual.',
  },
  {
    title: 'Context prefetch',
    body: "Plan and goal turns, and approved plans, start by reading `AGENTS.md`, `CLAUDE.md` and the files changed in the working tree. The reads use the session's own `Read` and are classified the same way. They stop at 12 files, 48 KiB per file and 128 KiB in total, and a file a permission rule would ask about is skipped.",
  },
];

const limits = [
  ['A fixed list of stores', 'Every location comes from a built-in list of known agent stores. The tools take no path, so they read those stores and nothing else on the machine.'],
  ['Read-only', "They read other agents' stores and have no way to write to them."],
  ['Always classified', 'Text in those stores was written by other models, so every result is classified before the model sees it.'],
  ['A record, to be checked', 'The model is told that a hit is a record of what an agent once wrote, to be checked against the current files.'],
  ['Bounded', 'A search stops at 200 matches, 256 KiB or ten seconds, and the result says when it was cut short.'],
  ['Works with what you have', 'It uses `rg` to narrow the files when it is installed. Goose and opencode are searched when `sqlite3` is on `PATH`, and the result says when they were skipped.'],
];

const split = (s: string) => s.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));
---

<SealedSection label="memory" sealText={sealText} id="memory">
  <SectionHead title="Memory and knowledge">
    Other coding agents on your machine have probably explored this repository already. Belai can search
    what they found instead of exploring again, and each turn starts with what the session already knows
    about the repository. It can also search the reference documents you give an agent, by meaning.
  </SectionHead>

  <Ladder steps={tools} from="finds a hit" to="rules and memory, across agents" />

  <SubHead title="Nine agents' sessions">
    Every hit names the agent, session, turn, role, time and project it came from, so the model can cite
    it.
  </SubHead>
  <div class="mt-head grid gap-8 @4xl:grid-cols-12">
    <ul class="m-0 grid min-w-0 list-none grid-cols-2 gap-2 p-0 @xl:grid-cols-3 @4xl:col-span-7">
      {agents.map((a) => (
        <li class={`flex min-h-16 flex-col justify-center rounded-xl border px-4 py-3 ${a === 'Belai' ? 'border-vx-ink bg-vx-ink text-vx-mint' : 'border-vx-ink'}`}>
          <span class="font-semibold">{a}</span>
          {needsSqlite.has(a) && <span class="mono text-xs text-vx-ink/60">needs sqlite3</span>}
        </li>
      ))}
    </ul>
    <div class="min-w-0 rounded-xl bg-vx-ink p-5 @4xl:col-span-5">
      <p class="mono text-xs tracking-wider text-vx-cream/70">EVERY HIT CARRIES</p>
      <dl class="mono mt-3 grid grid-cols-[7rem_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
        {hit.map(([k, v]) => (
          <>
            <dt class="text-vx-mint">{k}</dt>
            <dd class="m-0 font-sans text-vx-cream/80">{v}</dd>
          </>
        ))}
      </dl>
    </div>
  </div>

  <SubHead title="What the session already knows">
    Each turn starts with facts the harness worked out itself. None of them carries file contents, so
    the model does not have to ask again.
  </SubHead>
  <div class="mt-head grid gap-5 @3xl:grid-cols-3">
    {knows.map((k) => (
      <article class="flex flex-col rounded-xl border border-vx-ink p-5">
        <h4 class="text-lg font-bold">{k.title}</h4>
        <p class="mt-2 text-sm text-vx-ink/80">
          {split(k.body).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}
        </p>
      </article>
    ))}
  </div>

  <SubHead id="knowledge" title="Search your reference documents by meaning">
    Beside the usual answer, a model gets passages that resemble its query from the documents an agent
    profile lists and from the scanner output in <code class="mono">.vulnetix</code>.
  </SubHead>
  <Limits items={knowledge} cols={2} class="mt-head" />

  <SubHead title="Limits on cross-agent search">
    These apply to the session and memory search described above.
  </SubHead>
  <Limits items={limits} class="mt-head" />
</SealedSection>
