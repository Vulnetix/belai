---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import CopyButton from '../ui/CopyButton.tsx';

// The headless CLI as a command reference: one-shot runs, CI, the
// subcommands and the gates, each group a terminal block beside its notes.

const sealText =
  'Headless CLI: the same harness without the TUI. Terminal detection keeps the UI off in pipelines, -prompt gives a single answer and exits, -plan runs read-only, -detect-mode prints the mode choice, -trust-dir opens a CI workspace, -export prints a session as Markdown, -usage-json records what a run spent, belai acp serves editors, belai plugin manages plugins, belai kanban files work on the board, belai agent runs crews of workers that take it, and every posture gate is reachable from flags. The subcommands are agent, kanban, rc, plugin, acp and login, and belai help followed by a command prints that command own flags. -teleport continues a session from another host, sandbox or the web in this checkout under a new id. The top-level flags fall into five groups: session, model, safety, security classifier and other.';

const groups = [
  {
    title: 'One-shot runs',
    lines: [
      ['belai -prompt "review this diff"', 'prints a single reply and exits. Pair it with -provider, -model and -effort, or let settings.json supply the defaults.'],
      ['belai -plan -prompt "map the repo"', 'runs the plan-mode surface with Bash absent, writes a structured plan document, and exits without asking for approval.'],
      ['belai -detect-mode -prompt "…"', 'runs the mode classifier and prints the mode it would pick. No tools run.'],
      ['belai -prompt "…" -usage-json usage.json', 'writes the tokens the run spent per role and per model, cache reads and writes included, even when the run fails.'],
      ['belai -export <id-prefix>', 'prints a deterministic Markdown transcript of a saved session. It reads the session store and nothing in the repository.'],
    ],
  },
  {
    title: 'In CI',
    lines: [
      ['BELAI_NO_TUI=1', 'The TUI launches only when stdin and stdout are both terminals. In a pipeline, under GitHub Actions, or with BELAI_NO_TUI=1 or CI set, Belai stays headless.'],
      ['belai -trust-dir', 'grants trust to the current directory once, so an unattended job can start in a fresh checkout without a prompt.'],
      ['tests.post_end', 'With it set, a -prompt run that completes a goal, or ends on a changed tree at session level, runs the detected tests. The result and report go to stderr, stdout stays the reply, and the exit code is unchanged, so a script reads stderr to gate on the result.'],
      ['-guardrails -ask-permission -tools -firewall -verbose', 'Every gate works from the command line. Scripts get the same blocking defaults as the TUI.'],
    ],
  },
  {
    title: 'Subcommands',
    lines: [
      ['belai acp', 'serves the Agent Client Protocol on stdin and stdout, so Zed, JetBrains IDEs and Neovim plugins drive Belai with every gate in place. An untrusted directory is refused without a prompt.'],
      ['belai plugin install <git-url|dir>', 'prints every skill, hook command, prompt and agent a plugin adds and installs only on your yes, or -yes after reading it. list, update, enable, disable and remove manage what is installed.'],
      ['belai kanban add "…" -label build', 'add, list, show, move, note, release and import put work on the board from scripts. Labels, priority, an assignee and dependencies route it, and -json prints items for tooling.'],
      ['belai rc --detach', 'remote control: the Vulnetix website starts and drives sessions on this machine, in the directories you offer. --status shows the daemon and --stop ends it.'],
      ['belai login kiro', 'signs in to Kiro with an AWS Builder ID or an IAM Identity Center start URL, and -import reuses the sign-in Kiro already made.'],
      ['belai -teleport <id>', 'continues a session of your account from another host, a Pix Sandbox or the web, in the checkout you are in, under a new id. The original keeps running, and -teleport-ref picks the commit to check out.'],
      ['belai help <command>', 'prints the command\'s own flags, the same as belai <command> -h.'],
      ['belai agent start -crew belai:delivery', 'starts detached worker agents that claim items off the board. ps, logs and stop manage them, run -once works one item in the foreground, and import validates a JSON or Markdown profile.'],
    ],
  },
];

const flagGroups: [string, string, string[]][] = [
  ['Session', 'what to run and what to keep', ['-prompt', '-mode', '-plan', '-resume', '-continue', '-teleport', '-teleport-ref', '-export', '-no-transcript', '-usage-json', '-detect-mode']],
  ['Model', 'who answers and how', ['-provider', '-model', '-effort', '-firewall', '-caveman', '-defer-tools', '-tools', '-agent', '-agent-create']],
  ['Safety', 'the gates, and the choice to relax one', ['-guardrails', '-ask-permission', '-trust-dir', '-dangerously-yolo-everything', '-allow-unsafe-prompt', '-allow-malformed-prompt', '-allow-unsafe-tool-result', '-allow-malformed-tool-result', '-allow-unpermitted-tools', '-allow-ask-without-tty', '-allow-invalid-skills', '-allow-invalid-hooks', '-tool-call-mismatch']],
  ['Security classifier', 'the engine and each phase', ['-classifier-kind', '-classifier-provider', '-classifier-model', '-classifier-effort', '-classifier-phase1-model', '-classifier-phase1-source', '-classifier-phase1-threshold', '-classifier-phase2-model', '-classifier-phase2-source', '-classifier-phase2-threshold']],
  ['Other', 'output and housekeeping', ['-verbose', '-session-retention-days', '-no-prune', '-version']],
];

const ci = `BELAI_NO_TUI=1 belai -trust-dir \\
  -plan -prompt "map the repo" \\
  -usage-json usage.json`;
---

<SealedSection label="cli" sealText={sealText} id="cli">
  <SectionHead title="Headless CLI">
    Belai is the same binary in a terminal and in a CI job. From the command line you can set the mode,
    guardrails, permissions, provider and agents without starting the terminal UI.
  </SectionHead>

  <div class="mt-head grid gap-6 @4xl:grid-cols-12 @4xl:items-stretch">
    <div class="min-w-0 rounded-xl bg-vx-ink p-5 @4xl:col-span-7">
      <p class="mono text-xs tracking-wider text-vx-cream/70">A READ-ONLY PLAN IN CI</p>
      <pre class="mono mt-3 overflow-x-auto text-sm leading-7 text-vx-mint"><code>{ci}</code></pre>
      <div class="mt-3"><CopyButton value={ci} label="copy" client:visible /></div>
    </div>
    <dl class="m-0 grid min-w-0 gap-px overflow-hidden rounded-xl border border-vx-ink bg-vx-ink/20 @4xl:col-span-5">
      <div class="bg-vx-cream p-4"><dt class="mono text-xs text-vx-ink/60">UI</dt><dd class="m-0 mt-1">off in pipelines, by itself</dd></div>
      <div class="bg-vx-cream p-4"><dt class="mono text-xs text-vx-ink/60">GATES</dt><dd class="m-0 mt-1">the same fail-closed defaults as the TUI</dd></div>
      <div class="bg-vx-cream p-4"><dt class="mono text-xs text-vx-ink/60">TRUST</dt><dd class="m-0 mt-1">refused in an untrusted directory, unless you pass <code class="mono">-trust-dir</code></dd></div>
    </dl>
  </div>

  {groups.map((g) => (
    <>
      <SubHead title={g.title} />
      <ul class="mt-head list-none overflow-hidden rounded-xl border border-vx-ink p-0">
        {g.lines.map(([cmd, what]) => (
          <li class="grid gap-x-6 gap-y-1 border-b border-vx-ink/15 px-5 py-4 last:border-b-0 @3xl:grid-cols-[minmax(0,26rem)_minmax(0,1fr)]">
            <code class="mono break-words text-sm font-semibold text-vx-ink">{cmd}</code>
            <span class="text-sm text-vx-ink/80">{what}</span>
          </li>
        ))}
      </ul>
    </>
  ))}

  <SubHead title="Every flag, in five groups">
    <code class="mono">belai -h</code> prints them with their defaults. Each <code class="mono">-allow-*</code>
    flag relaxes one fail-closed check for one run, so relaxing a gate is a choice made on the command line.
  </SubHead>
  <details class="deep deep--wide">
    <summary>The flags by group</summary>
    <div class="deep__body">
      <dl class="mt-4 m-0 border-t border-vx-ink/60">
        {flagGroups.map(([group, what, flags]) => (
          <div class="grid gap-x-8 gap-y-2 border-b border-vx-ink/20 py-5 @3xl:grid-cols-[13rem_minmax(0,1fr)]">
            <dt>
              <span class="font-semibold">{group}</span>
              <span class="mt-1 block text-sm text-vx-ink/70">{what}</span>
            </dt>
            <dd class="m-0 flex flex-wrap gap-x-4 gap-y-1">
              {flags.map((f) => <code class="mono text-sm">{f}</code>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </details>
</SealedSection>
