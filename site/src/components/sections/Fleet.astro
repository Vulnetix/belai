---
import SealedSection from '../seal/SealedSection.astro';
import CopyButton from '../ui/CopyButton.tsx';
import fleetCrew from '../../assets/concepts/fleet-crew.svg?raw';

const docBase = 'https://github.com/Vulnetix/belai/blob/main/docs/';

const sealText =
  'Agent crews: worker agents that take their work from the kanban board. Each worker is its own belai process. The harness claims an item under the board lock, so two workers never hold the same one, and renews a lease while it works. The item text reaches the model as a classified attachment. Code-writing workers get a git worktree on their own belai branch outside the repository, commit there inside the OS sandbox, and push only through PublishBranch, which pushes exactly that branch and opens a draft pull request. The release note is harness facts. belai:delivery runs a scout, two builders and a reviewer; belai:security a vulnerability scout, two patchers and a verifier. A repository can only turn workers off or lower their count.';

const quickstart = `belai kanban add "Add a CONTRIBUTING.md" -label build
belai agent start -crew belai:delivery -trust-dir
belai agent ps; belai kanban list
belai agent stop -all`;

const crews = [
  {
    name: 'belai:delivery',
    lead: 'Turn a request into reviewed branches.',
    members: [
      ['belai:scout ×1', 'claims a #scout request, reads the code, and hands off one #build item per concrete task, in order'],
      ['belai:builder ×2', 'claims a #build item, implements it on its own branch, runs the checks, commits, and opens a draft PR'],
      ['belai:reviewer ×1', 'claims #needs-review, checks the branch out, reads the diff, runs just check, then approves it or sends it back with notes'],
    ],
  },
  {
    name: 'belai:security',
    lead: 'Turn a scan into verified fixes.',
    members: [
      ['belai:vuln-scout ×1', 'claims a #vuln-scan request, runs the Vulnetix scans, and hands off one #vuln item per finding, by severity'],
      ['belai:patcher ×2', 'claims a #vuln item, bumps or patches it on its own branch, regenerates the lockfile, commits, and opens a draft PR'],
      ['belai:verifier ×1', 'claims #needs-verify, rescans the branch, and closes the item or sends it back'],
    ],
  },
];

// Recorded from a real run on this repository, with the released v0.57.2
// binary: the builder's own commit and draft pull request.
const run = [
  ['12:17', 'added to backlog', '#build', 'belai kanban add'],
  ['12:20', 'backlog → in_progress', 'claimed by agent belai:builder', 'harness'],
  ['12:27', 'note', 'draft pull request opened: Vulnetix/belai#6', 'PublishBranch'],
  ['12:28', 'in_progress → review', 'agent belai:builder completed it (2 passes); 1 file changed on belai/K-507600/a1', 'harness'],
  ['12:29', 'review → in_progress', 'claimed by agent belai:reviewer', 'harness'],
];

const guards = [
  {
    title: 'The harness claims',
    body: 'No model can claim an item. A claim is one locked read-modify-write of the board file, so two workers never hold the same item, and a stale sync cannot undo it. A lease that lapses, because a worker crashed, returns the item to the list it came from.',
  },
  {
    title: 'Item text is untrusted',
    body: 'The claimed item rides as a classified attachment, like a KanbanSearch result: never the prompt, the system block or a directive. A withheld item is blocked, never worked. The notes the harness writes back are facts, never model text.',
  },
  {
    title: 'A worktree per item',
    body: 'Code-writing workers get a git worktree outside the repository, on a branch of their own: belai/K-xxxxxx/a1. Settings, trust and credentials come from the trusted repository root, never the worktree, so one agent cannot plant settings for the next.',
  },
  {
    title: 'Git, but only its own',
    body: 'Inside the OS sandbox an agent runs git status, diff, log and commit on its branch. Your config, hooks, HEAD, index, objects and every other ref stay read-only; its new objects go to a private store the harness copies in. It cannot plant a hook, move main, or touch another item’s branch.',
  },
  {
    title: 'One way to push',
    body: 'PublishBranch pushes exactly the item’s branch to a GitHub or GitLab origin and opens a draft pull request. git push, gh pr create and merge, git switch, git config and git remote are denied in a worker, so an injected item cannot push to main.',
  },
  {
    title: 'Fail closed',
    body: 'A worker cannot turn guardrails off. An autonomous worker needs a pass budget, and one with Bash needs a working OS sandbox or it refuses to start. A tool call it cannot ask about blocks the item with a note for you, and it never widens.',
  },
];

const profile = `---
name: docs-writer
description: Writes and updates documentation items
mode: worker
autonomy: autonomous
tools: [Read, Grep, Glob, Edit, Write, Bash]
kanban:
  labels: [docs]
  on_success: {list: review, labels: [needs-review], drop_labels: [docs]}
  handoff_to: [belai:builder]
  handoff_labels: [build]
  max_attempts: 3
workspace: {isolation: worktree, publish: agent}
budget: {max_passes_per_item: 6, max_wall_per_item: 30m}
memory: {enabled: true}
---
You document one kanban item per turn. Read the code it names,
write the docs, check every link, commit on your branch, then
PublishBranch with a title and what you changed.`;

const comparison = [
  ['Claims', 'atomic, TTL, stale reclaim', 'claim tokens', 'atomic under the board lock, renewed lease, reclaimed on expiry or a dead process'],
  ['Routing', 'assignee profile', 'bindings', 'labels, priority, assignee, dependencies, a handoff allowlist'],
  ['Workspaces', 'scratch, dir, worktree', 'per-agent workspace', 'a worktree per item, outside the repo, on its own branch'],
  ['Untrusted item text', 'heuristic injection scan', 'random-boundary tags', 'the security classifier on every item, memory and handoff'],
  ['Pushing', 'the agent’s own git', 'the agent’s own git', 'PublishBranch only: its own branch, a draft PR'],
  ['Isolation', '“the OS is the only boundary”', 'optional sandbox', 'an OS sandbox per command, required for Bash workers'],
];
---

<SealedSection label="fleet" sealText={sealText} id="fleet">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
    <div class="prose-measure">
      <h2 class="text-3xl font-bold text-vx-ink">Agent crews.</h2>
      <p class="mt-4 text-vx-ink/80">
        The kanban board is where work waits. A crew is a set of agents that take it from there
        without you: a scout breaks a request into tasks, builders each claim one and implement it on
        a branch of their own, and a reviewer checks the branch and approves it or sends it back.
        They hand work to each other on the board and nowhere else, so every step shows in{' '}
        <code class="mono">/kanban</code>, in <code class="mono">belai kanban list</code> and on the
        Vulnetix website.
      </p>
      <p class="mt-4 text-vx-ink/80">
        Each worker is its own <code class="mono">belai</code> process that outlives your terminal.
        You file work, start a crew, and review the draft pull requests it opens.
      </p>
    </div>
    <div class="rounded-lg border border-vx-ink p-2" aria-hidden="true"><Fragment set:html={fleetCrew} /></div>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-2">
    <div class="min-w-0">
      <h3 class="text-xl font-bold text-vx-ink">Four commands.</h3>
      <p class="mt-3 text-vx-ink/80">
        File an item, start the delivery crew in a repository you trust, watch it work, stop it. A
        stopped worker hands its item back untouched; a stop is not a failure.
      </p>
      <div class="mt-4 rounded-lg bg-vx-ink p-4">
        <pre class="mono overflow-x-auto text-sm text-vx-mint"><code>{quickstart}</code></pre>
      </div>
      <div class="mt-2"><CopyButton value={quickstart} label="copy commands" client:visible /></div>
      <p class="mt-3 text-sm text-vx-ink/70">
        In the TUI, <code class="mono">/fleet</code> opens the fleet tab of{' '}
        <code class="mono">/agents</code>: each worker's state, the item it holds, items done and failed,
        a heartbeat and its log. <code class="mono">/fleet crew belai:delivery</code> starts a crew from
        there. Without leaving the chat, <kbd class="mono">f9</kbd> opens the runs panel: its kanban tab
        moves, notes, routes and hands items to a crew with one key, and its crew tab starts and stops
        the workers beside them.
      </p>
    </div>
    <div class="min-w-0">
      <h3 class="text-xl font-bold text-vx-ink">A real run.</h3>
      <p class="mt-3 text-vx-ink/80">
        The item <code class="mono">K-507600</code>, “Add a CONTRIBUTING.md”, on this repository, worked
        by the released binary. The builder read the docs and the commit style, wrote the file,
        committed it itself and opened{' '}
        <a class="text-vx-ink underline" href="https://github.com/Vulnetix/belai/pull/6">draft PR #6</a>.
      </p>
      <ol class="mt-4 space-y-2 list-none p-0">
        {run.map(([at, move, what, who]) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-3 text-sm">
            <span class="mono text-vx-ink/60">{at}</span>
            <span>
              <span class="mono font-semibold text-vx-ink">{move}</span>
              <span class="text-vx-ink/80"> {what}</span>
              <span class="mono text-xs text-vx-mint-strong"> · {who}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-2">
    {crews.map((c) => (
      <article class="rounded-lg border border-vx-ink/30 p-5">
        <h3 class="mono text-base font-semibold text-vx-ink">{c.name}</h3>
        <p class="mt-1 text-sm text-vx-ink/70">{c.lead}</p>
        <ul class="mt-4 space-y-3 list-none p-0">
          {c.members.map(([who, does]) => (
            <li class="text-sm">
              <code class="mono rounded bg-vx-ink/10 px-2 py-0.5 text-xs">{who}</code>
              <p class="mt-1 text-vx-ink/80">{does}</p>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>

  <div class="mt-12">
    <h3 class="text-xl font-bold text-vx-ink">Autonomous, not unconfined.</h3>
    <p class="prose-measure mt-3 text-vx-ink/80">
      An unattended agent reading text other people and other models wrote is exactly the agent a
      prompt injection wants. So the crew runs on the same rules as everything else in Belai, and a
      few of its own.
    </p>
    <div class="mt-5 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {guards.map((g) => (
        <div class="rounded-lg border border-vx-ink/30 p-4">
          <h4 class="font-semibold text-vx-ink">{g.title}</h4>
          <p class="mt-2 text-sm text-vx-ink/80">{g.body}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-start">
    <div class="prose-measure">
      <h3 class="text-xl font-bold text-vx-ink">Your own crew.</h3>
      <p class="mt-4 text-vx-ink/80">
        A worker is an ordinary agent profile with <code class="mono">mode: worker</code>. Its{' '}
        <code class="mono">kanban</code> block says which items it takes and where they go next;{' '}
        <code class="mono">workspace</code> gives it a worktree and says whether it may publish;{' '}
        <code class="mono">budget</code> bounds one item; <code class="mono">memory</code> keeps a short,
        classified lessons file between items. Write it in JSON, or as Markdown with front-matter the way
        Claude Code, OpenClaw and Hermes do, then <code class="mono">belai agent import</code> it.
      </p>
      <p class="mt-4 text-vx-ink/80">
        A crew is just a list of profiles and how many of each. Validation fails closed: a worker that
        writes needs isolation, an autonomous one needs a budget, and nobody gets guardrails off. The
        project layer can turn workers off, lower their number or stop publishing, never the reverse.
      </p>
      <p class="mt-4 text-vx-ink/80">
        Read <a class="text-vx-ink underline" href={`${docBase}fleet.md`}>docs/fleet.md</a> for the
        runtime and <a class="text-vx-ink underline" href={`${docBase}agent-profiles.md`}>docs/agent-profiles.md</a>{' '}
        for every field.
      </p>
    </div>
    <div class="min-w-0">
      <div class="rounded-lg bg-vx-ink p-4">
        <pre class="mono overflow-x-auto text-xs leading-relaxed text-vx-mint"><code>{profile}</code></pre>
      </div>
      <div class="mt-2"><CopyButton value={profile} label="copy profile" client:visible /></div>
    </div>
  </div>

  <div class="mt-12">
    <h3 class="text-xl font-bold text-vx-ink">Next to other agent harnesses.</h3>
    <p class="prose-measure mt-3 text-vx-ink/80">
      Hermes Agent and OpenClaw pioneered agents that take work from a board. Belai keeps what works
      and puts the security model under it. Compared from their public source and docs at the time of
      writing.
    </p>
    <div class="mt-5 overflow-x-auto rounded-lg border border-vx-ink/30">
      <table class="w-full min-w-[40rem] text-left text-sm">
        <thead class="bg-vx-ink/5">
          <tr>
            <th class="px-4 py-2 font-semibold text-vx-ink"></th>
            <th class="px-4 py-2 font-semibold text-vx-ink">Hermes Agent</th>
            <th class="px-4 py-2 font-semibold text-vx-ink">OpenClaw</th>
            <th class="px-4 py-2 font-semibold text-vx-ink">Belai crews</th>
          </tr>
        </thead>
        <tbody>
          {comparison.map(([what, hermes, openclaw, belai]) => (
            <tr class="border-t border-vx-ink/15">
              <th scope="row" class="px-4 py-2 font-semibold text-vx-ink">{what}</th>
              <td class="px-4 py-2 text-vx-ink/75">{hermes}</td>
              <td class="px-4 py-2 text-vx-ink/75">{openclaw}</td>
              <td class="px-4 py-2 text-vx-ink">{belai}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</SealedSection>
