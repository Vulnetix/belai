---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import CopyButton from '../ui/CopyButton.tsx';

const sealText =
  'Getting started: install from Homebrew, Scoop, a checksum-verified install.sh, go install, or source. The default asset embeds the phase-1 guardrails model, --variant picks another family, and the first run asks you to trust the directory before anything reads it.';

const installs = [
  { name: 'Homebrew', cmd: 'brew install vulnetix/tap/belai' },
  { name: 'Scoop', cmd: 'scoop bucket add vulnetix https://github.com/Vulnetix/scoop-bucket && scoop install belai' },
  { name: 'install.sh, checksum-verified', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh' },
  { name: 'install.sh, another variant', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/belai/main/install.sh | sh -s -- --variant bert-guardrails-jailbreak' },
  { name: 'go install', cmd: 'go install github.com/vulnetix/belai/cmd/belai@latest' },
  { name: 'source', cmd: 'git clone https://github.com/vulnetix/belai && cd belai && go build ./cmd/belai' },
];

// Sizes drive the bars, relative to the largest family.
const variants = [
  { asset: 'belai-bert-guardrails', flag: 'bert-guardrails', tag: 'default', embeds: 'phase-1 prompt-saturation model and the speech model', size: 77, note: 'Guardrails classify locally with no provider and no API key configured.' },
  { asset: 'belai-bert-guardrails-jailbreak', flag: 'bert-guardrails-jailbreak', tag: '', embeds: 'phase-1 and phase-2 jailbreak models and the speech model', size: 517, note: 'Adds the local jailbreak gate, run in parallel with phase 1.' },
  { asset: 'belai', flag: 'vanilla', tag: '', embeds: 'nothing', size: 24, note: 'Classifies with the LLM sentinel, as Belai did before models were embedded. Voice input downloads its speech model on request.' },
  { asset: 'belai-no-classifier', flag: 'no-classifier', tag: '', embeds: 'the speech model only', size: 56, note: 'For hosts that classify somewhere else entirely. Voice input works with no download.' },
];
const maxSize = Math.max(...variants.map((v) => v.size));

const firstSteps = [
  ['belai', 'launch the TUI'],
  ['trust this directory?', 'a first-run directory is gated on an explicit yes, before anything reads it'],
  ['/help', 'commands and shortcuts, guarded by a test'],
  ['type a prompt', 'or / to fuzzy-find commands, prompts, agents and processes'],
  ['shift+tab', 'cycle agent, plan, goal'],
  ['-detect-mode', 'print the mode decision without acting on it'],
  ['/model', 'pick a provider and model, and see the classifier kind and phase rows'],
  ['tab', 'cycle model mode between routed and defined, in chat or on /model'],
];
---

<SealedSection label="start" sealText={sealText} id="start">
  <SectionHead title="Getting started">
    Belai runs on linux, darwin and windows, on amd64 and arm64. Each release is built by the same
    workflow that publishes the Homebrew formula and the Scoop manifest, and the installer checks the
    binary against the release checksums before writing anything.
  </SectionHead>

  <div class="mt-10 grid gap-8 lg:grid-cols-12">
    <div class="min-w-0 lg:col-span-7">
      <p class="mono text-xs tracking-wider text-vx-ink/60">01 · INSTALL</p>
      <ul class="mt-3 list-none space-y-3 p-0">
        {installs.map((i, idx) => (
          <li class={`rounded-xl border border-vx-ink p-4 ${idx === 0 ? 'bg-vx-ink text-vx-cream' : ''}`}>
            <div class="flex items-center justify-between gap-3">
              <p class={`mono text-sm ${idx === 0 ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{i.name}</p>
              <CopyButton value={i.cmd} label="copy" client:visible />
            </div>
            <code class={`mono mt-2 block break-all text-sm ${idx === 0 ? 'text-vx-mint' : 'text-vx-ink'}`}>{i.cmd}</code>
          </li>
        ))}
      </ul>
    </div>

    <div class="min-w-0 lg:col-span-5">
      <p class="mono text-xs tracking-wider text-vx-ink/60">02 · FIRST RUN</p>
      <ol class="mono mt-3 list-none overflow-hidden rounded-xl bg-tui-ink p-0 text-sm text-tui-cream">
        {firstSteps.map(([cmd, what], i) => (
          <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-2 border-b border-tui-cream/10 px-4 py-3 last:border-b-0">
            <span class="opacity-50">{i + 1}</span>
            <span>
              <span class="text-tui-teal-soft">{cmd}</span>
              <span class="mt-0.5 block font-sans text-[13px] opacity-75">{what}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <SubHead title="Which binary you get">
    Releases ship in four asset families. Homebrew, Scoop and <code class="mono">install.sh</code> all
    default to <code class="mono">belai-bert-guardrails</code>, which includes the phase-1 model in the
    binary, so guardrails work straight away without a configured provider, an API key or a model
    download.
  </SubHead>

  <ul class="mt-8 list-none overflow-hidden rounded-xl border border-vx-ink p-0">
    {variants.map((v) => (
      <li class={`grid gap-x-6 gap-y-2 border-b border-vx-ink/15 p-5 last:border-b-0 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)_minmax(0,14rem)] lg:items-center ${v.tag ? 'bg-vx-mint/15' : ''}`}>
        <div class="min-w-0">
          <p class="flex flex-wrap items-center gap-2">
            <code class="mono font-semibold">{v.asset}</code>
            {v.tag && <span class="mono rounded-md bg-vx-ink px-2 py-0.5 text-xs text-vx-mint">{v.tag}</span>}
          </p>
          <p class="mono mt-1 text-xs text-vx-ink/60">--variant {v.flag}</p>
        </div>
        <div class="min-w-0">
          <p class="text-sm text-vx-ink/80">{v.note}</p>
          <p class="mono mt-1 text-xs text-vx-ink/60">embeds {v.embeds}</p>
        </div>
        <div class="flex items-center gap-3">
          <span class="h-2 flex-1 overflow-hidden rounded-full bg-vx-ink/10">
            <span class="block h-full rounded-full bg-vx-ink" style={`width: ${Math.max(4, (v.size / maxSize) * 100)}%`}></span>
          </span>
          <span class="mono w-16 text-right text-sm">~{v.size} MB</span>
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-6 max-w-[72ch] text-vx-ink/80">
    Pick a family with <code class="mono">--variant</code> or <code class="mono">BELAI_VARIANT</code>. The
    installed command is <code class="mono">belai</code> for every family, and each binary updates itself
    within its own family. Building from source stays on the LLM sentinel path unless you run the
    model-prep recipes yourself.
  </p>

  <footer class="mt-16 flex flex-wrap items-center justify-between gap-4 border-t-2 border-vx-ink pt-6 text-vx-ink/70">
    <p class="mono text-sm">
      belai · Apache-2.0 · <a class="underline" href="https://github.com/vulnetix/belai">github.com/vulnetix/belai</a>
    </p>
    <p class="text-sm">Free and open source, like the Vulnetix scanners, AI Firewall and MCP server.</p>
  </footer>
</SealedSection>
