---
import SealedSection from '../seal/SealedSection.astro';
import CopyButton from '../ui/CopyButton.tsx';

const sealText =
  'Getting started: install from Homebrew, Scoop, a checksum-verified install.sh, go install, or source. The default asset embeds the phase-1 guardrails model, --variant picks another family, and the first run asks you to trust the directory before anything reads it.';

const installs = [
  { name: 'Homebrew', cmd: 'brew install vulnetix/tap/signet' },
  { name: 'Scoop', cmd: 'scoop bucket add vulnetix https://github.com/Vulnetix/scoop-bucket && scoop install signet' },
  { name: 'install.sh (checksum-verified)', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/signet/main/install.sh | sh' },
  { name: 'install.sh, another variant', cmd: 'curl -fsSL https://raw.githubusercontent.com/vulnetix/signet/main/install.sh | sh -s -- --variant bert-guardrails-jailbreak' },
  { name: 'go install', cmd: 'go install github.com/vulnetix/signet/cmd/signet@latest' },
  { name: 'source', cmd: 'git clone https://github.com/vulnetix/signet && cd signet && go build ./cmd/signet' },
];

const variants = [
  {
    asset: 'signet-bert-guardrails',
    tag: 'default',
    embeds: 'phase-1 prompt-saturation model',
    size: '~40 MB',
    note: 'Guardrails classify locally with no provider and no API key configured.',
  },
  {
    asset: 'signet-bert-guardrails-jailbreak',
    tag: null,
    embeds: 'phase-1 + phase-2 jailbreak model',
    size: '~485 MB',
    note: 'Adds the local jailbreak gate, run in parallel with phase 1.',
  },
  {
    asset: 'signet',
    tag: null,
    embeds: 'nothing',
    size: '~23 MB',
    note: 'Classifies with the LLM sentinel, as Signet did before models were embedded.',
  },
  {
    asset: 'signet-no-classifier',
    tag: null,
    embeds: 'nothing',
    size: '~23 MB',
    note: 'For hosts that classify somewhere else entirely.',
  },
];

const firstSteps = [
  ['signet', 'launch the TUI'],
  ['trust this directory?', 'a first-run directory is gated on an explicit yes, before anything reads it'],
  ['/help', 'commands and shortcuts, guarded by a test'],
  ['type a prompt', 'or / to browse slash commands'],
  ['shift+tab', 'cycle agent, plan, goal'],
  ['-detect-mode', 'print the mode decision without acting on it'],
  ['/model', 'pick a provider and model, and see the classifier kind and phase rows'],
];
---

<SealedSection label="start" sealText={sealText} id="start">
  <h2 class="text-3xl font-bold text-vx-ink">Getting started.</h2>
  <p class="prose-measure mt-4 text-vx-ink/80">
    Signet runs on linux, darwin and windows, on amd64 and arm64. Each release is built by the same
    workflow that publishes the Homebrew formula and the Scoop manifest, and the installer checks the
    binary against the release checksums before writing anything.
  </p>

  <div class="mt-8 grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="mono text-sm font-semibold text-vx-ink/60">install</h3>
      <ul class="mt-3 space-y-3 list-none p-0">
        {installs.map((i) => (
          <li class="rounded-md border border-vx-ink/30 p-4">
            <p class="mono text-sm text-vx-ink/60">{i.name}</p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <code class="mono block overflow-x-auto text-sm text-vx-ink">{i.cmd}</code>
              <CopyButton value={i.cmd} label="copy" client:load />
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="mono text-sm font-semibold text-vx-ink/60">first run</h3>
      <ol class="mt-3 list-none space-y-3 p-0">
        {firstSteps.map(([cmd, what]) => (
          <li class="rounded-md border border-vx-ink/30 p-4">
            <p class="mono text-sm text-vx-ink/60">{what}</p>
            <code class="mono mt-1 block text-sm text-vx-ink">{cmd}</code>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <div class="mt-12">
    <h3 class="text-2xl font-bold text-vx-ink">Which binary you get.</h3>
    <p class="prose-measure mt-4 text-vx-ink/80">
      Releases ship in four asset families. Homebrew, Scoop and <code class="mono">install.sh</code> all
      default to <code class="mono">signet-bert-guardrails</code>, which includes the phase-1 model in the
      binary. Guardrails work straight away, without a configured provider, an API key or a model
      download. The installed command is <code class="mono">signet</code> for every family, and each binary
      updates itself within its own family.
    </p>

    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {variants.map((v) => (
        <article class="rounded-lg border border-vx-ink/30 p-5">
          <div class="flex flex-wrap items-center gap-2">
            <code class="mono text-sm font-semibold text-vx-ink">{v.asset}</code>
            {v.tag && (
              <span class="mono rounded border border-vx-ink px-2 py-0.5 text-xs text-vx-ink">{v.tag}</span>
            )}
          </div>
          <p class="mono mt-2 text-xs text-vx-ink/60">embeds: {v.embeds} · {v.size}</p>
          <p class="mt-2 text-sm text-vx-ink/80">{v.note}</p>
        </article>
      ))}
    </div>

    <p class="prose-measure mt-6 text-vx-ink/80">
      Pick a family with <code class="mono">--variant</code> (or <code class="mono">SIGNET_VARIANT</code>):{' '}
      <code class="mono">bert-guardrails</code>, <code class="mono">bert-guardrails-jailbreak</code>,{' '}
      <code class="mono">no-classifier</code>, or <code class="mono">vanilla</code>. Building from source
      stays on the LLM sentinel path unless you run the model-prep recipes yourself.
    </p>
  </div>

  <footer class="mt-12 border-t border-vx-ink/30 pt-6 text-vx-ink/70">
    <p class="mono text-sm">
      signet · Apache-2.0 · <a class="underline" href="https://github.com/vulnetix/signet">github.com/vulnetix/signet</a>
    </p>
    <p class="mt-2 text-sm">
      Free and open source, like the Vulnetix scanners, AI Firewall and MCP server.
    </p>
  </footer>
</SealedSection>
