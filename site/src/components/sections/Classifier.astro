<script>
  // The WITHHELD stamp lands once, when the example scrolls into view. Without
  // JS (or with reduced motion) it is simply there.
  const caught = document.querySelector<HTMLElement>('.caught');
  if (caught && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    caught.classList.add('caught--armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          caught.classList.add('caught--hit');
          io.disconnect();
        }
      },
      { threshold: 0.5 },
    );
    io.observe(caught);
  }
</script>

<style>
  .caught__stamp {
    transform: rotate(-7deg);
  }

  .caught--armed .caught__stamp {
    opacity: 0;
    transform: rotate(-7deg) scale(1.6);
  }

  .caught--armed.caught--hit .caught__stamp {
    animation: stamp-in 420ms cubic-bezier(0.5, 0, 0.75, 0) 250ms forwards;
  }

  @keyframes stamp-in {
    60% { opacity: 1; transform: rotate(-7deg) scale(0.94); }
    to { opacity: 1; transform: rotate(-7deg) scale(1); }
  }
</style>
