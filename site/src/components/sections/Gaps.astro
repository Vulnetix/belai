---
import SealedSection from '../seal/SealedSection.astro';

const sealText =
  'Honest gaps: no MCP, no image attachments yet. This is the cheapest credibility on the page and consistent with the posture.';
---

<SealedSection label="gaps" sealText={sealText} id="gaps">
  <div class="prose-measure">
    <h2 class="text-3xl font-bold text-vx-ink">Honest gaps.</h2>
    <p class="mt-4 text-vx-ink/80">
      No MCP. No image attachments yet. This is the cheapest credibility on the page and consistent
      with the product&rsquo;s posture: fail closed, and say what is not there.
    </p>
    <p class="mt-4 text-vx-ink/80">
      When they land, they land the same way as everything else. Behind the classifier, inside the
      posture gates, and documented in a file with a test.
    </p>
  </div>
</SealedSection>