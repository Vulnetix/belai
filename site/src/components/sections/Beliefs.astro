---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import pixYolo from '../../assets/pix/pix-yolo.svg?raw';
import pixProfessor from '../../assets/pix/pix-professor.svg?raw';
import pixConductor from '../../assets/pix/pix-conductor.svg?raw';
import pixHomestead from '../../assets/pix/pix-homestead.svg?raw';

// The beliefs sit straight under the intro as a quiet row: small drawings,
// no card borders, the same four statements as before.

const sealText =
  'What Belai is built on. Four decisions sit under every other feature on this page. Four beliefs: safety above all else and easy to YOLO. Roles for determinism: each judgement is a separate tool-less call with a one-token answer, so work and judgement are never confused, and modes are sticky. Tools first class: common CLIs such as AWS, GCloud, Kubectl, GH, JQ and YQ are structured tools, checked per call and run without a shell, so they cannot be used to pop one. Local first, open source, with Apache-2.0, zero telemetry, embedded classifier models that need no API key, two local providers, and Strands Decider-2B to answer every role manager decision on your own machine.';

const beliefs = [
  {
    title: 'Safety first, and easy to YOLO',
    body: 'Press f3 and guardrails go off everywhere: the classifier is not called, and a red chip in the footer says so. /yolo turns permission asks off with them. Turning guardrails back on restores every check in the session, inline commands, file attachments, background agents and the CLI.',
    svg: pixYolo,
  },
  {
    title: 'Roles for determinism',
    body: 'Each judgement is its own role, with its own prompt, no tools and a one-token answer: the security check, the mode choice, the plan and goal checks. A model is never asked to do the work and judge it in the same call, so it cannot confuse the two. A mode you pick stays until you change it.',
    svg: pixProfessor,
  },
  {
    title: 'Tools first class',
    body: 'AWS, GCloud, Kubectl, Terraform, GH, JQ, YQ and about 40 more are tools of their own. Each call is checked against what that tool may do, read-only commands only for the cloud CLIs, and the binary gets its arguments directly, never through a shell, so a ; or $(…) in an argument stays text. A poisoned file cannot talk the model into popping a shell through them, the trick that works on a general Bash tool.',
    svg: pixConductor,
  },
  {
    title: 'Local first and open source',
    body: 'Belai is Apache-2.0 and sends no telemetry or logs. The default download includes its classifier model, so guardrails run locally without a provider or API key. Strands Decider-2B can answer every role manager decision on your machine in place of remote Jev: the security check, the mode, routing and the relevance jobs, with no key. Ollama and llama-server work out of the box, and the Vulnetix scanners and AI Firewall are free for everyone.',
    svg: pixHomestead,
  },
];
---

<SealedSection label="beliefs" sealText={sealText} id="beliefs">
  <SectionHead title="What Belai is built on">
    Four decisions sit under every other feature on this page.
  </SectionHead>
  <div class="mt-head grid gap-x-12 gap-y-12 @2xl:grid-cols-2">
    {beliefs.map((b) => (
      <article class="flex min-w-0 flex-col gap-3">
        <div class="flex items-center gap-3">
          <div class="w-12 shrink-0 opacity-90" aria-hidden="true"><Fragment set:html={b.svg} /></div>
          <h3 class="text-lg font-semibold leading-snug text-vx-ink">{b.title}</h3>
        </div>
        <p class="text-base leading-relaxed text-vx-ink/80">{b.body}</p>
      </article>
    ))}
  </div>
</SealedSection>
