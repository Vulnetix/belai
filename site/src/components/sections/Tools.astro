---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Ladder from '../ui/Ladder.astro';
import Limits from '../ui/Limits.astro';
import cdConfine from '../../assets/concepts/cd-confinement.svg?raw';

// Tools and the OS sandbox: the core tools, the native catalogue (from
// internal/tools/catalog.go, with the kind each one has), where a path may
// go, and the boundary Bash runs inside (internal/sandbox).

const sealText =
  'Tools: the core tools take the arguments models are trained on, a fixed-argv native catalogue of 25 read-only utilities never goes through a shell, and Cd is confined so the working directory moves inside the session roots. Bash, inline !cmd and supervised processes run in an OS sandbox: bubblewrap on Linux or sandbox-exec on macOS. The workspace roots, a private /tmp and the usual tool caches are writable, the state directory is hidden, and the network can be denied. A repository can only tighten it; guardrails off turns it off; required refuses to run without a backend. Other repositories on this machine: Repos lists the git checkouts among the sibling directories of the working directory, two levels deep, without following a symlink, RepoFiles lists a checkout with git ls-files and RepoRead reads one file from it, each call limited to the checkout it names, and a file RepoRead returns is classified like any file read.';

const docBase = 'https://github.com/Vulnetix/belai/blob/main/docs/';

const tiers = [
  {
    n: '01',
    name: 'Core tools',
    key: 'Read · Grep · Edit',
    lead: 'The tools every model already knows, with the argument shapes it was trained on, so a call is right the first time.',
  },
  {
    n: '02',
    name: 'Native catalogue',
    key: '25 tools',
    lead: 'Read-only utilities as tools of their own. Each runs one binary with a fixed argument shape, passed to `exec.Command` without a shell.',
  },
  {
    n: '03',
    name: 'Bash, sandboxed',
    key: 'bubblewrap · sandbox-exec',
    lead: 'An arbitrary command runs inside an operating-system boundary where only your workspace, a private `/tmp` and tool caches are writable.',
  },
];

// Every native tool, grouped. `read` marks the ones that can print a file's
// contents, whose output is classified; the rest are shaped and sanitised.
const catalogue = [
  { group: 'files', tools: [['Cat', true], ['Head', true], ['Tail', true], ['Strings', true], ['File', false]] },
  { group: 'listing', tools: [['LS', false], ['Find', false]] },
  { group: 'git', tools: [['Git', false]] },
  { group: 'transform', tools: [['JQ', true], ['YQ', true], ['Sed', true], ['Awk', true], ['Cut', true], ['Sort', true], ['Uniq', true], ['Tr', true], ['Paste', true], ['Join', true], ['WC', false]] },
  { group: 'compare', tools: [['Diff', true], ['Cmp', false]] },
  { group: 'environment', tools: [['Echo', false], ['Date', false], ['Pwd', false], ['Env', false]] },
] as const;

const core = [
  ['Grep', '`glob`, `type`, `-i`, context lines and `output_mode`'],
  ['Bash', 'a `timeout` of up to ten minutes, two by default, so a normal test run finishes'],
  ['Edit · Write', 'refuse a file the model has not read in this session, or one that changed on disk since'],
  ['Git', 'status, log, diff, show, rev-parse, ls-files, grep and describe, nothing that writes'],
  ['Bash · BashOutput · KillShell', '`run_in_background` starts a server and returns a handle, BashOutput reads what it printed since the last read, KillShell stops it. It asks and runs in the sandbox like any Bash call, and is never restarted by the recovery agent'],
  ['Screenshot', 'a page served from this machine, rendered in headless Chrome or Chromium with every request to anywhere else blocked, or the desktop, which asks every time. Only loopback addresses are accepted, and Belai checks that a server is listening first. The PNG is kept under `~/.vulnetix/belai/screenshots` (newest 20) and the path is in the result'],
  ['Images', 'a text classifier cannot read pixels, so Belai decodes an image from Screenshot, an `@file.png`, the clipboard or an editor, limits its size, scales it to 1568 pixels on the long edge and re-encodes it. Only the newest image is sent, and a model without image input is told it was not. A custom provider can declare it per model with `"images": true` or `false`, and `ui.clipboard_images`, `screenshot.enabled` and `screenshot.desktop` can be turned off by a project file and never on. Screenshot is in the interactive session only'],
];

const locateFacts: [string, string][] = [
  ['Eligible files only', 'Dependency and build folders, hidden files, symlinks, binaries, files over 16 MiB, anything your <code class="mono">.gitignore</code> or <code class="mono">.ignore</code> excludes, and files that hold credentials are never listed, ranked or sent.'],
  ['Keywords first', 'Every file is scored by the words in its path. The decision backend then rates the likeliest folders, then the files inside them, and a file it cannot rate keeps its keyword score.'],
  ['Names stay home by default', 'Declared function and type names go only to the local decision model or a server you run. OpenRouter and TypeSafe\'s hosted API see paths and sizes. <code class="mono">jev.locate_previews</code> changes that either way.'],
  ['What a subagent reads', 'One line of up to eight <code class="mono">path:line</code> entries made of plain characters, so no file name can add words to a prompt.'],
];

const swapSteps = [
  'The command must be one plain command: no pipe, chain, redirect, substitution or line break.',
  'A Bash deny rule that matches it stops the swap, so a swap never launders a denied command.',
  'A decision model rates the builtin tools that could stand in for it. Exactly one must rate at 95 percent or more as a full replacement.',
  "The fast model is asked to reconsider and write that tool's arguments, or answer KEEP_BASH. Every value must appear in the original command.",
  'The builtin must pass its own schema, permissions and mode. Its output is classified as Bash output would be.',
];

const sandbox = [
  { what: 'Writable', items: ['the workspace roots, including folders added with `/add-dir`', 'a private `/tmp` that exists only for that command', 'with `caches` on, the usual tool caches: `~/.cache`, `~/go`, `~/.npm`, `~/.cargo`, `~/.m2`, `~/.gradle` and more'], tone: 'bg-vx-mint/25' },
  { what: 'Read-only', items: ['everything else your account can see'], tone: 'bg-vx-bone/60' },
  { what: 'Hidden', items: ['`~/.vulnetix/belai`, which holds credentials and sessions. The command sees an empty directory'], tone: 'bg-vx-ink text-vx-cream' },
  { what: 'Network', items: ['available by default, so builds work', '`"network": "deny"` turns it off'], tone: 'bg-vx-sand/60' },
];

const sandboxModes = [
  ['off', 'commands run as your account, with no boundary'],
  ['auto', 'the default: sandboxed when a backend works here, unsandboxed otherwise'],
  ['required', 'commands run only inside the sandbox, and are refused when no backend works'],
];

const limits = [
  ['One binary per tool', 'A native tool runs its own binary with the arguments it was given. Free-form command strings are rejected.'],
  ['Content still classifies', 'A native tool that can print a file, such as `Cat`, `JQ` or `Diff`, is classified like `Read`.'],
  ['Cd stays inside', '`Cd` moves the working directory anywhere inside the session roots. A path such as `../../../etc` is refused.'],
  ['A repository only tightens', 'A project can raise `sandbox.mode`, deny the network and turn caches off. Loosening any of them takes your own settings, and a project\'s `extra_writable` is dropped.'],
  ['One switch', 'Guardrails off turns the sandbox off with every other check. `/sandbox` shows the policy in effect.'],
  ['Everything that runs a command', '`Bash` in every mode and in explore subagents, inline `!cmd`, supervised processes, and MCP stdio servers that opt in. The command dies with Belai.'],
];

const repoTools: [string, string][] = [
  ['A bounded scan', '`Repos` lists the git checkouts among the sibling directories of the working directory, two levels deep. The scan is bounded in time and size, skips `node_modules`, `vendor`, `target` and `dist`, and never follows a symlink. Nothing is fetched or cloned: a miss lists what is available locally.'],
  ['One checkout per call', '`RepoFiles` runs `git ls-files` in a checkout and `RepoRead` reads one file from it. Each call is limited to the checkout it names, and a path with a `..` that escapes the checkout is refused.'],
  ['Named from the remote', 'A checkout is named `owner/repo` from its origin remote, or by a bare name when only one matches. What `RepoRead` returns is classified like any file you read.'],
];

const split = (s: string) => s.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));
---

<SealedSection label="tools" sealText={sealText} id="tools">
  <SectionHead title="Tools and the sandbox">
    Belai gives the model the tools it was trained on, a catalogue of read-only utilities that never go
    through a shell, and a sandbox for the commands that do.
  </SectionHead>

  <Ladder steps={tiers} from="shapes Belai knows" to="an arbitrary command, fenced by the OS">
    <svg slot="art-0" viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
      {[['Read', 10, 18], ['Grep', 116, 18], ['Glob', 222, 18], ['Edit', 10, 64], ['Write', 116, 64], ['Bash', 222, 64]].map(([t, x, y]) => (
        <>
          <rect x={x} y={y} width="88" height="30" rx="6" class={t === 'Bash' ? '' : 'fill-vx-bone'} />
          <text x={Number(x) + 14} y={Number(y) + 20} font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">{t}</text>
        </>
      ))}
    </svg>
    <svg slot="art-1" viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="10" y="30" width="120" height="50" rx="8" class="fill-vx-bone" />
      <text x="24" y="52" font-family="Geist Mono, monospace" font-size="12" fill="currentColor" stroke="none">JQ</text>
      <text x="24" y="68" font-family="Geist Mono, monospace" font-size="10" class="fill-vx-ink/60" stroke="none">filter, path</text>
      <path d="M130 55 H176" /><path d="M168 49 L177 55 L168 61" stroke-linejoin="round" />
      <rect x="178" y="30" width="132" height="50" rx="8" />
      <text x="190" y="59" font-family="Geist Mono, monospace" font-size="9.5" fill="currentColor" stroke="none">["jq", filter, path]</text>
    </svg>
    <svg slot="art-2" viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
      <rect x="8" y="8" width="304" height="94" rx="10" stroke-dasharray="5 4" />
      <rect x="24" y="26" width="120" height="58" rx="8" class="fill-vx-mint" stroke="none" />
      <text x="38" y="52" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink" stroke="none">workspace</text>
      <text x="38" y="68" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink" stroke="none">/tmp · caches</text>
      <rect x="160" y="26" width="136" height="58" rx="8" class="stroke-vx-cream/40" />
      <text x="174" y="52" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream/80" stroke="none">read-only</text>
      <text x="174" y="68" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream/80" stroke="none">the rest</text>
    </svg>
  </Ladder>

  <SubHead title="The native catalogue">
    Belai includes 25 read-only utilities as tools, each running a specific binary with a fixed argument
    shape. A tool that can print a file's contents is classified like <code class="mono">Read</code>; the
    rest return output whose shape Belai knows.
  </SubHead>
  <details class="deep deep--wide">
    <summary>The 25 tools, by group</summary>
    <div class="deep__body">
  <div class="mt-4 grid gap-4 @xl:grid-cols-2 @4xl:grid-cols-3">
    {catalogue.map((g) => (
      <div class={`rounded-xl border border-vx-ink p-4 ${g.group === 'transform' ? '@4xl:row-span-2' : ''}`}>
        <p class="mono text-xs tracking-wider text-vx-ink/60">{g.group.toUpperCase()}</p>
        <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
          {g.tools.map(([name, reads]) => (
            <li class={`mono rounded-md border px-2.5 py-1 text-sm ${reads ? 'border-vx-ink bg-vx-ink text-vx-mint' : 'border-vx-ink/40'}`}>{name}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <p class="mono mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-vx-ink/70">
    <span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm bg-vx-ink align-[-0.05em]"></span>can print a file, so classified</span>
    <span><span class="mr-1.5 inline-block h-2.5 w-2.5 rounded-sm border border-vx-ink/40 align-[-0.05em]"></span>shaped output, sanitised</span>
  </p>
    </div>
  </details>

  <SubHead title="Arguments models already know">
    The core tools take the arguments models are trained on, so the model does not have to learn a new
    shape for the same job.
  </SubHead>
  <details class="deep deep--wide">
    <summary>The core tools and their arguments</summary>
    <div class="deep__body">
  <dl class="mt-4 grid gap-px overflow-hidden rounded-xl border border-vx-ink bg-vx-ink/20 @2xl:grid-cols-2">
    {core.map(([tool, what]) => (
      <div class="bg-vx-cream p-5">
        <dt><code class="mono text-base font-semibold">{tool}</code></dt>
        <dd class="m-0 mt-2 text-vx-ink/80">{split(what).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}</dd>
      </div>
    ))}
  </dl>
    </div>
  </details>

  <SubHead title="The right tool for the command">
    With a decision backend configured, a plain <code class="mono">grep -rn</code> or{' '}
    <code class="mono">cat</code> sent to <code class="mono">Bash</code> can run as the builtin tool made for
    it. The model is told, in the result, that the swap happened.
  </SubHead>
  <details class="deep">
    <summary>The steps of a swap, and when one is skipped</summary>
    <div class="deep__body">
  <ol class="mt-4 list-none p-0">
    {swapSteps.map((step, i) => (
      <li class={`grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-4 ${i < swapSteps.length - 1 ? 'border-b border-vx-ink/20' : ''}`}>
        <span class="mono text-vx-ink/60">{i + 1}</span>
        <p>{step}</p>
      </li>
    ))}
  </ol>
  <p class="mt-3 text-sm text-vx-ink/75">
    Any failed step leaves the Bash call to run as written. The row reads{' '}
    <code class="mono">Grep ← Bash</code>, and a command sent twice runs as Bash the second time.{' '}
    <a class="underline" href={`${docBase}jev-jobs.md`}>More on decision jobs</a>
  </p>
    </div>
  </details>

  <SubHead title="Where to look first">
    Before the explore subagents start, Belai ranks the files your goal is about and hands each subagent the
    best few, so they search less. The model can ask for the same list with the deferred{' '}
    <code class="mono">Locate</code> tool. It returns paths, line numbers and percentages, never file text.
  </SubHead>
  <dl class="mt-8 grid gap-x-8 gap-y-4 @2xl:grid-cols-[minmax(0,14rem)_minmax(0,1fr)]">
    {locateFacts.map(([term, text]) => (
      <>
        <dt class="font-semibold">{term}</dt>
        <dd class="m-0"><Fragment set:html={text} /></dd>
      </>
    ))}
  </dl>
  <p class="mt-3 text-sm text-vx-ink/75">
    <code class="mono">/locate --dry-run</code> shows what would be looked at and where the questions would go,
    without sending anything.{' '}
    <a class="underline" href={`${docBase}jev-jobs.md#explore-locate`}>More on decision jobs</a>
  </p>

  <SubHead title="Where a path can go">
    <code class="mono">Cd</code> can move the working directory anywhere inside the session root and
    nowhere outside it. You can still reach past the root yourself: <code class="mono">@../</code>,{' '}
    <code class="mono">@/</code> or <code class="mono">@~/</code> browses one folder at a time.
  </SubHead>
  <div class="mt-head grid gap-8 @4xl:grid-cols-2 @4xl:items-center">
    <div class="rounded-xl border border-vx-ink p-2" aria-hidden="true"><Fragment set:html={cdConfine} /></div>
    <ol class="m-0 list-none p-0">
      <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-b border-vx-ink/20 py-4">
        <span class="mono text-vx-ink/60">1</span>
        <p>Entries outside the session roots carry an amber <code class="mono">⚠</code> in the <code class="mono">@</code> chooser.</p>
      </li>
      <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 border-b border-vx-ink/20 py-4">
        <span class="mono text-vx-ink/60">2</span>
        <p>Attaching one asks first: add its folder as a root for this session, save it for the project like <code class="mono">/add-dir</code>, or decline.</p>
      </li>
      <li class="grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-4">
        <span class="mono text-vx-ink/60">3</span>
        <p>Nothing outside the roots is read until you say yes, and a folder that contains the session root is refused.</p>
      </li>
    </ol>
  </div>

  <SubHead id="repos" title="Other repositories on this machine">
    A task sometimes needs a file from a sibling checkout, such as a shared workflow or a library. Three
    tools read it without moving the working directory.
  </SubHead>
  <Limits items={repoTools} class="mt-head" />

  <SubHead id="sandbox" title="The sandbox">
    Belai's own file tools stay inside the workspace roots, but a command can reach anything your account
    can. So <code class="mono">Bash</code>, inline <code class="mono">!cmd</code> and supervised processes run
    under an operating-system boundary: bubblewrap on Linux, <code class="mono">sandbox-exec</code> on macOS.
  </SubHead>
  <div class="mt-head grid gap-4 @2xl:grid-cols-2 @5xl:grid-cols-4">
    {sandbox.map((s) => (
      <div class={`rounded-xl border border-vx-ink p-5 ${s.tone}`}>
        <p class="mono text-xs tracking-wider opacity-70">{s.what.toUpperCase()}</p>
        <ul class="mt-3 list-none space-y-2 p-0 text-sm">
          {s.items.map((it) => <li>{split(it).map(({ p, c }) => (c ? <code class="mono">{p}</code> : p))}</li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="mt-6 grid gap-8 @4xl:grid-cols-12 @4xl:items-start">
    <dl class="m-0 grid min-w-0 gap-px overflow-hidden rounded-xl border border-vx-ink bg-vx-ink/20 @xl:grid-cols-3 @4xl:col-span-8">
      {sandboxModes.map(([mode, what]) => (
        <div class="bg-vx-cream p-4">
          <dt><code class="mono font-semibold">sandbox.mode: {mode}</code></dt>
          <dd class="m-0 mt-1 text-sm text-vx-ink/75">{what}</dd>
        </div>
      ))}
    </dl>
    <div class="min-w-0 rounded-xl bg-vx-ink p-5 @4xl:col-span-4">
      <p class="mono text-xs tracking-wider text-vx-cream/70">THE STRICT POLICY</p>
      <pre class="mono mt-3 overflow-x-auto text-sm leading-7 text-vx-mint"><code>{`"sandbox": {
  "mode": "required",
  "network": "deny",
  "caches": false
}`}</code></pre>
      <p class="mt-2 text-sm text-vx-cream/75">
        Only the roots and the private <code class="mono">/tmp</code> are writable, and nothing leaves the
        machine. <a class="text-vx-cream underline" href={`${docBase}sandbox.md`}>docs/sandbox.md</a>
      </p>
    </div>
  </div>

  <Limits items={limits} />
</SealedSection>
