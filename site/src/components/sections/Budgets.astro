---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Shot from '../ui/Shot.astro';
import Limits from '../ui/Limits.astro';
import footerShot from '../../assets/shots/footer.svg';

// Token budgets: three windows (session, day, month), the footer's three
// colours, and what counts against a budget.

const sealText =
  "Token budgets: a global allowance per provider and model for the session, the local day and the local month. Every completed model call counts, classifier and role-manager calls included. The footer shows the selected model's budget right-aligned and cycles between them; teal while tokens last as long as the clock, amber when spend runs ahead of it, red when exhausted. Past sessions are imported from their transcripts once, so day and month totals cover every project. A budget only warns. Smaller requests, measured: defer_tools sends the core tools in full and loads the rest through ToolSearch, an oversized result becomes a preview and a reference read back with ReadResult, -usage-json writes tokens per role and model with the request composition as sizes only, and context_windows overrides a model window. Compaction runs on numbers you set (compaction.*), with a breaker that pauses a failing summary, /compact takes a focus and /cache keeps the prompt prefix warm. /context and an opt-in reply cost line show where tokens and estimated spend went, on screen only. Run caps put a ceiling on one session's cost, tokens or turn time: the model is told once to wrap up, and the run stops at the cap unless you extend it.";

const windows = [
  {
    n: '01',
    name: 'Session',
    key: 'session',
    lead: 'Counts this session only. A session budget has no clock to run ahead of, so it is teal until it is spent and never turns amber.',
  },
  {
    n: '02',
    name: 'Day',
    key: 'day',
    lead: 'Counts the local day across every project. The bar turns amber when a larger share of the day is left than of the tokens.',
  },
  {
    n: '03',
    name: 'Month',
    key: 'month',
    lead: 'Counts the local month. Sessions from before budgets existed are read from their transcripts once, in the background, and counted as well.',
  },
];

// Illustrative footer states. The captures below are the real footer.
const colours = [
  { name: 'Teal', title: 'on pace', body: 'The tokens are lasting at least as long as the clock.', bar: 'bg-tui-teal', fill: 'w-[62%]', text: 'day  62% · 9h left' },
  { name: 'Amber', title: 'running ahead', body: 'A larger share of the day or month is left than of the tokens.', bar: 'bg-tui-amber', fill: 'w-[31%]', text: 'day  31% · 14h left' },
  { name: 'Red', title: 'spent', body: 'The allowance is used up. The next call still runs.', bar: 'bg-tui-danger', fill: 'w-full', text: 'month  0% · 11d left' },
];

const counts = [
  ['your turns', 'Every call the session makes, and headless runs'],
  ['agents', 'Subagents and background agents'],
  ['classifier and role manager', 'Every security check and every one-token verdict'],
  ['no usage reported', 'Belai estimates the usage and marks it as estimated'],
  ['a goal run', 'Its exact token count, split across the days it ran'],
  ['older sessions', "Imported from transcripts. A transcript keeps only its last call's usage, so the imported figure is a lower bound"],
];

const docBase = 'https://github.com/Vulnetix/belai/blob/main/docs/';

const economy: [string, string][] = [
  ['Core tools in full, the rest on demand', '`defer_tools` is on by default. A request carries the core tools in full and names the rest in a sealed briefing. `ToolSearch` loads a definition into later requests, and a deferred tool stays callable by name.'],
  ['Large results stay out of the history', 'A result above the size limit becomes a head-and-tail preview and a reference. `ReadResult` reads slices of the stored result when the model asks, and each slice is classified.'],
  ['See where the tokens went', '`belai -prompt "…" -usage-json file` writes a summary on exit: tokens per role and model, cache reads and writes, and the request composition, which is the size of the system prompt, tool definitions, history and each tool\'s results. Sizes only, never content. `/context` shows the same live, and `ui.reply_cost` adds a cost line to each reply.'],
  ['Windows you can correct', '`context_windows` overrides the context window Belai assumes for a model, in tokens.'],
  ['Compaction you can set', 'A long session compacts at `compaction.threshold_pct` (70) of the window. Five more keys set what a prune keeps and when a failing summary pauses. A cloned repository can only compact sooner or keep more.'],
  ['A prompt cache you can keep warm', '`/cache ttl 1h` asks the provider to hold your prefix for an hour, and `/cache keepalive N` allows up to N idle pings, off by default. A ping replays the last request and discards the reply.'],
];

const economyDeep: [string, string][] = [
  ['Six compaction keys', '`threshold_pct` 70, `keep_recent_turns` 6, `keep_result_chars` 300, `keep_tool_results` 2, `breaker_failures` 3 and `breaker_cooldown_passes` 4, under `compaction` in settings. A project value that would compact later or keep less is dropped with a note.'],
  ['A failing summary pauses', 'After three failed summaries in a row the summary step pauses for four pass boundaries while pruning goes on. The terminal saves the pause with the session, so a resume does not retry at once. ACP, headless, remote and fleet sessions apply the numbers and keep the pause in memory.'],
  ['/compact in the terminal', '`/compact <focus>` steers one summary (500 characters, on the user side only) and `/compact status` shows the thresholds and the breaker without a model call. A manual summary is classified before it is stored, and a refusal leaves the session as it was.'],
  ['What a ping does', 'The gap is 270 seconds (3300 with `1h`) and at most 100 pings run. A ping stops on any refused answer, and waits while a turn runs, in plan mode, under an open ask, with a spent budget and on a local provider. Its tokens are booked under the role `keepalive`.'],
  ['A changed prefix is named', 'A `cache_prefix_changed` row says whether the system block or the tool definitions changed. The `prompt_cache` block is read from your own settings only. The lifetime applies wherever the native Anthropic provider is used, and pings run only in the terminal.'],
  ['/context and the cost line', '`/context` prints the system prompt, tool definitions, history and the five largest tool results against the model\'s window, with free room and an estimated session cost. `ui.reply_cost` (off by default) adds a dim line such as `in 12.3k (cache 90%) · out 410 · ~$0.031 est.`. Both are estimates from reported counts and list prices, shown on screen and never sent to a model.'],
];

const runSteps = [
  'Set a ceiling in `run_caps` (`max_cost_usd`, `max_tokens`, `max_wall_minutes`, all off by default) or for one run with `-max-cost`, `-max-tokens` and `-max-wall`.',
  'At 90 percent of a cap (`finalize_at`) the model gets one fixed wrap-up directive with no number in it.',
  'At the cap the run stops unless you extend it by half the original ceiling, up to three times: a key on the terminal ask, the editor\'s choice over ACP, or a typed `/caps extend`.',
];

const runDeep: [string, string][] = [
  ['Only you extend', 'A headless `-prompt` run stops with exit code 3. A remote session, a subagent, ask off, the website, a spoken word and the decision model never extend.'],
  ['A repository can only lower', 'A project file can add a cap or lower one, and lower `finalize_at` and `max_extends`. Raising or clearing a cap takes your own settings or a flag.'],
  ['Measured by the harness', 'Cost is an estimate at the model\'s list price, and a model with no known price leaves the cost cap off. Wall time counts turns only. A subagent spends on its parent\'s meter, and a fleet worker keeps its own profile budget.'],
  ['Where it shows', 'A footer chip shows the largest used share and `/caps` lists each cap. Counters are saved per session, so a resume keeps the spend, and the audit log records the outcome as a word and a pass count.'],
];

const split = (s: string) => s.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));

const limits = [
  ['Set in your own settings', "Budgets are global. A repository's settings file cannot raise or remove them."],
  ['Counted once', 'A session is never counted twice, even when two belai windows import it at the same time.'],
  ['Warnings only', 'A call over budget still runs. Turn on ui.budget_warn for a warning line on every call while a budget is amber or red. A run cap is what stops one.'],
];
---

<SealedSection label="budgets" sealText={sealText} id="budgets">
  <SectionHead title="Token budgets" surfaces={['tui', 'acp', 'cli', 'self-hosted', 'software factory']}>
      Give any provider and model an allowance for the session, the local day or the local month, up to
      one of each. Every completed model call counts against the model that served it, including the
      classifier's calls.
    </SectionHead>

  <ol class="mt-head grid list-none gap-5 p-0 @3xl:grid-cols-3">
    {windows.map((w, i) => {
      const dark = i === 2;
      return (
        <li class={`flex flex-col gap-4 rounded-xl border border-vx-ink p-6 ${dark ? 'bg-vx-ink text-vx-cream' : ''}`}>
          <div class="flex items-center justify-between">
            <span class={`mono text-sm ${dark ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{w.n}</span>
            <kbd class={`mono rounded-md border border-b-[3px] px-2 py-0.5 text-sm ${dark ? 'border-vx-mint text-vx-mint' : 'border-vx-ink'}`}>{w.key}</kbd>
          </div>
          {i === 0 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <text x="10" y="30" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/65" stroke="none">tokens left</text>
              <rect x="10" y="44" width="300" height="22" rx="11" />
              <rect x="10" y="44" width="190" height="22" rx="11" class="fill-vx-mint-strong" stroke="none" />
              <text x="10" y="92" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/65" stroke="none">no clock</text>
            </svg>
          )}
          {i === 1 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <text x="10" y="20" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/65" stroke="none">tokens left</text>
              <rect x="10" y="30" width="300" height="18" rx="9" />
              <rect x="10" y="30" width="120" height="18" rx="9" class="fill-vx-sand-amber" stroke="none" />
              <rect x="10" y="66" width="300" height="18" rx="9" />
              <rect x="10" y="66" width="190" height="18" rx="9" fill="currentColor" stroke="none" />
              <text x="10" y="104" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink/65" stroke="none">day left</text>
            </svg>
          )}
          {i === 2 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full text-vx-mint" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="10" y="14" width="300" height="82" rx="8" class="stroke-vx-cream/30" />
              <g stroke="none">
                {[[22, 16], [42, 28], [62, 22], [82, 40], [102, 32], [122, 48]].map(([x, h]) => (
                  <rect x={x} y={86 - h} width="14" height={h} fill="currentColor" />
                ))}
                {[[142, 24], [162, 36], [182, 20]].map(([x, h]) => (
                  <rect x={x} y={86 - h} width="14" height={h} class="fill-vx-cream/35" />
                ))}
              </g>
              <text x="210" y="44" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream/70" stroke="none">imported</text>
              <text x="210" y="60" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream/70" stroke="none">from older</text>
              <text x="210" y="76" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream/70" stroke="none">transcripts</text>
            </svg>
          )}
          <h3 class="text-2xl font-bold">{w.name}</h3>
          <p class={dark ? 'text-vx-cream/85' : 'text-vx-ink/80'}>{w.lead}</p>
        </li>
      );
    })}
  </ol>

  <SubHead title="Three colours in the footer" surfaces={['tui']}>
      With <code class="mono">defined</code> routing, the right of the footer's top line shows the selected
      model's budget: the share of tokens left, the time left in the day or month, and a bar. With two or
      more budgets the footer cycles between them every ten seconds
      (<code class="mono">ui.budget_cycle_seconds</code>).
    </SubHead>
  <div class="mt-head grid gap-5 @2xl:grid-cols-3">
    {colours.map((c) => (
      <div class="overflow-hidden rounded-xl border border-vx-ink">
        <p class="mono flex items-center justify-between gap-3 bg-tui-ink px-4 py-3 text-[13px] text-tui-cream" aria-hidden="true">
          <span>{c.text}</span>
          <span class="flex h-2 w-16 rounded-full bg-tui-cream/20"><span class={`rounded-full ${c.bar} ${c.fill}`}></span></span>
        </p>
        <div class="p-5">
          <h4 class="text-lg font-bold">{c.name}: {c.title}</h4>
          <p class="mt-2 text-sm text-vx-ink/80">{c.body}</p>
        </div>
      </div>
    ))}
  </div>

  <SubHead title="What counts">
      Prompt and completion tokens, reasoning included, under the provider and model that served the
      call. Usage goes into one ledger that every belai process shares.
    </SubHead>
  <div class="mt-head grid gap-8 @4xl:grid-cols-12">
    <div class="min-w-0 @4xl:col-span-8">
      <ol class="list-none p-0">
        {counts.map(([what, detail]) => (
          <li class="grid gap-x-4 gap-y-1 border-b border-vx-ink/20 py-3.5 text-sm last:border-b-0 @2xl:grid-cols-[14rem_minmax(0,1fr)] md:text-[15px]">
            <span class="mono font-semibold">{what}</span>
            <span class="text-vx-ink/85">{detail}</span>
          </li>
        ))}
      </ol>
    </div>
    <div class="min-w-0 @4xl:col-span-4">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">SET ONE</p>
        <p class="mt-3 flex flex-wrap items-baseline gap-3 text-vx-cream">
          <kbd class="mono rounded-md border border-b-[3px] border-vx-mint px-2 text-sm text-vx-mint">f1</kbd>
          <span>then</span>
          <kbd class="mono rounded-md border border-b-[3px] border-vx-mint px-2 text-sm text-vx-mint">b</kbd>
          <span class="text-vx-cream/70">or</span>
          <code class="mono text-vx-mint">/budgets</code>
          <span class="text-vx-cream/70">or the token budgets row in</span>
          <code class="mono text-vx-mint">/settings</code>
        </p>
        <p class="mt-3 text-sm text-vx-cream/75">
          Type allowances as <code class="mono">250k</code> or <code class="mono">1.5M</code>.
        </p>
      </div>
    </div>
  </div>
  <Shot
    class="mt-8"
    shot={footerShot}
    title="status footer"
    alt="The status footer with an amber day budget on the right of the top line and the guardrails chip on the second"
    rows={[0, 2]}
    marks={[{ row: 0, col: 71 }, { row: 1, col: 27 }]}
    notes={['The day budget turns amber when spend runs ahead of the clock.', 'The guardrails switch, on.']}
  />

  <SubHead id="economy" title="Smaller requests, measured">
    Budgets cap what a session may spend. These settings and tools reduce what each request sends in the
    first place, and show where the tokens went.
  </SubHead>
  <Limits items={economy} cols={2} class="mt-head" />

  <details class="deep deep--wide">
    <summary>Compaction keys, the breaker, /cache and /context</summary>
    <div class="deep__body">
      <Limits items={economyDeep} cols={2} class="mt-4" />
      <p class="mt-3 text-sm text-vx-ink/75">
        <a class="underline" href={`${docBase}compaction.md`}>docs/compaction.md</a> ·{' '}
        <a class="underline" href={`${docBase}prompt-cache.md`}>docs/prompt-cache.md</a> ·{' '}
        <a class="underline" href={`${docBase}token-budgets.md#context-and-reply-cost`}>docs/token-budgets.md</a>
      </p>
    </div>
  </details>

  <SubHead id="run-caps" title="A ceiling that stops a run" surfaces={['tui', 'acp', 'cli', 'self-hosted']}>
    A budget only warns. A run cap puts a ceiling on one session's cost, tokens or turn time, and the
    harness enforces it. The model never sees the number.
  </SubHead>
  <ol class="mt-head list-none p-0">
    {runSteps.map((step, i) => (
      <li class={`grid grid-cols-[2rem_minmax(0,1fr)] gap-3 py-4 ${i < runSteps.length - 1 ? 'border-b border-vx-ink/20' : ''}`}>
        <span class="mono text-vx-ink/60">{i + 1}</span>
        <p>{split(step).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}</p>
      </li>
    ))}
  </ol>
  <details class="deep deep--wide">
    <summary>Who can extend, what a cap measures and where it shows</summary>
    <div class="deep__body">
      <Limits items={runDeep} cols={2} class="mt-4" />
      <p class="mt-3 text-sm text-vx-ink/75">
        <a class="underline" href={`${docBase}run-caps.md`}>docs/run-caps.md</a>
      </p>
    </div>
  </details>

  <div class="mt-sub grid border-t border-vx-ink/60 @3xl:grid-cols-3">
    {limits.map(([title, body]) => (
      <div class="border-b border-vx-ink/20 py-6 @3xl:pr-8">
        <h4 class="text-lg font-bold">{title}</h4>
        <p class="mt-2 text-sm text-vx-ink/80">
          {body.split(/(ui\.budget_warn)/).map((p) => (p === 'ui.budget_warn' ? <code class="mono">{p}</code> : p))}
        </p>
      </div>
    ))}
  </div>
</SealedSection>
