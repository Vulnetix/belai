---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Shot from '../ui/Shot.astro';
import Limits from '../ui/Limits.astro';
import localModelShot from '../../assets/shots/local-model.svg';

// Providers: hosted, local and the classifier, then the credential layers,
// local instances and the classifier's rows in /model.

const sealText =
  'Providers and local inference: five-layer credential resolution with provenance, ollama and llama-server in the box, multiple named instances with display labels, a /local-model assess verdict, and a classifier role with its own kind and phase rows. Twenty providers: OpenAI, Anthropic, Google Gemini, xAI, Mistral and DeepSeek; OpenRouter, Cloudflare Workers AI, Cloudflare AI Gateway, Hugging Face, Groq, Fireworks and Together; Moonshot, MiniMax and Alibaba; GitHub Copilot and Kiro, which sign in without an API key; Ollama and llama-server on your machine; and any custom endpoint in one of three wire formats. With nothing configured Belai starts on OpenRouter\'s free router, and a repository cannot define a provider unless your global settings allow it.';

const kinds = [
  {
    n: '01',
    name: 'Hosted',
    key: '/credentials',
    lead: 'Credentials are read from five layers, and every resolved value records the layer it came from.',
  },
  {
    n: '02',
    name: 'Local',
    key: '/local-model',
    lead: 'ollama and llama-server work with no extra setup, as many named instances as you run, on this machine or another.',
  },
  {
    n: '03',
    name: 'Classifier',
    key: '/model',
    lead: 'The security classifier has its own rows. With a local classifier model, untrusted content is judged on your own machine.',
  },
];

const catalogue: [string, string][] = [
  ['Model labs', 'OpenAI, Anthropic, Google Gemini, xAI, Mistral, DeepSeek'],
  ['Hosts and gateways', 'OpenRouter, Cloudflare Workers AI, Cloudflare AI Gateway, Hugging Face, Groq, Fireworks, Together'],
  ['Regional', 'Moonshot, MiniMax, Alibaba'],
  ['Sign in, no key', 'GitHub Copilot (OAuth), Kiro (AWS Builder ID or IAM Identity Center)'],
  ['On your machine', 'Ollama, llama-server'],
  ['Anything else', 'A custom endpoint in the openai-chat, openai-responses or anthropic-messages format'],
];

const setup: [string, string][] = [
  ['Nothing configured', 'Belai starts on OpenRouter\'s free router. If exactly one other provider\'s credentials resolve, it adopts that provider instead.'],
  ['Sign in with AWS', '`belai login kiro` runs the AWS sign-in itself, with a Builder ID or an IAM Identity Center start URL, and stores the login as the provider\'s one credential.'],
  ['Your own endpoint', 'A `providers` block in `settings.json` names a base URL and one of the three formats. A self-hosted endpoint that needs no key is offered while its `/models` answers.'],
  ['Providers come from you', 'Project settings can define a provider only when your global settings set `allow_project_providers`, because a hostile repository that defined one could collect an API key.'],
];

const layers = ['Command line', 'Environment', 'Config file', 'Agent profile', 'Built-in defaults'];

const instanceKeys = [
  ['kind', 'ollama, llama-server or openai-compatible, to copy a built-in template'],
  ['provider_labels', 'a display name'],
];

const classifierRows = [
  ['kind', 'models, the embedded BERT models, or llm, the sentinel'],
  ['phase rows', 'The model each phase uses, including when phase 3 is off'],
];

const code = /(\bollama\b|llama-server|openai-compatible|\bmodels\b|\bllm\b)/;
const split = (s: string) => s.split(code).map((p) => ({ p, c: code.test(p) }));
---

<SealedSection label="providers" sealText={sealText} id="providers">
  <SectionHead title="Providers">
      Use hosted models, models on your own machine, or both. The security classifier can run on
      either, and every credential records where it came from.
    </SectionHead>

  <ol class="mt-10 grid list-none gap-5 p-0 @3xl:grid-cols-3">
    {kinds.map((k, i) => {
      const dark = i === 2;
      return (
        <li class={`flex flex-col gap-4 rounded-xl border border-vx-ink p-6 ${dark ? 'bg-vx-ink text-vx-cream' : ''}`}>
          <div class="flex items-center justify-between">
            <span class={`mono text-sm ${dark ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{k.n}</span>
            <kbd class={`mono rounded-md border border-b-[3px] px-2 py-0.5 text-sm ${dark ? 'border-vx-mint text-vx-mint' : 'border-vx-ink'}`}>{k.key}</kbd>
          </div>
          {i === 0 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              {[10, 30, 50, 70, 90].map((y) => (
                <rect x="10" y={y} width="300" height="16" rx="4" class={y === 30 ? 'fill-vx-mint' : ''} stroke={y === 30 ? 'none' : 'currentColor'} />
              ))}
              <text x="20" y="42" font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">environment ◆ this key came from here</text>
            </svg>
          )}
          {i === 1 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="20" y="18" width="120" height="74" rx="8" class="fill-vx-bone" />
              <path d="M20 36 H140" />
              <circle cx="32" cy="27" r="3" class="fill-vx-mint-strong" stroke="none" />
              <text x="32" y="60" font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">ollama</text>
              <text x="32" y="78" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink/60" stroke="none">this machine</text>
              <path d="M140 55 L180 55" stroke-dasharray="3 4" />
              <rect x="180" y="18" width="120" height="74" rx="8" stroke-dasharray="3 3" />
              <path d="M180 36 H300" stroke-dasharray="3 3" />
              <text x="192" y="60" font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">llama-server</text>
              <text x="192" y="78" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-ink/60" stroke="none">another host</text>
            </svg>
          )}
          {i === 2 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full text-vx-mint" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              {[[12, 'kind', 'models · llm'], [44, 'phase 1, 2', 'a model per phase'], [76, 'phase 3', 'on or off']].map(([y, k, v]) => (
                <>
                  <rect x="10" y={y} width="300" height="24" rx="6" class="stroke-vx-cream/35" />
                  <text x="22" y={Number(y) + 17} font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream" stroke="none">{k}</text>
                  <text x="130" y={Number(y) + 17} font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">{v}</text>
                </>
              ))}
            </svg>
          )}
          <h3 class="text-2xl font-bold">{k.name}</h3>
          <p class={dark ? 'text-vx-cream/85' : 'text-vx-ink/80'}>{split(k.lead).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}</p>
        </li>
      );
    })}
  </ol>

  <SubHead title="Twenty providers and any endpoint you add">
    Each role in <code class="mono">/model</code> can use a different one, so the agent, the classifier
    and the fast tier need not share a provider.
  </SubHead>
  <dl class="mt-head m-0 border-t border-vx-ink/60">
    {catalogue.map(([group, names]) => (
      <div class="grid gap-x-8 gap-y-1 border-b border-vx-ink/20 py-4 @3xl:grid-cols-[13rem_minmax(0,1fr)]">
        <dt class="mono text-sm text-vx-ink/70">{group}</dt>
        <dd class="m-0">{names}</dd>
      </div>
    ))}
  </dl>
  <details class="deep deep--wide">
    <summary>Defaults, sign-in, custom endpoints and who may add a provider</summary>
    <div class="deep__body">
      <Limits items={setup} cols={2} class="mt-4" />
    </div>
  </details>

  <SubHead title="Where a credential comes from">
      Belai reads five layers in this order, and each value it resolves carries the name of the layer
      that supplied it.
    </SubHead>
  <ol class="mt-8 grid list-none overflow-hidden rounded-xl border border-vx-ink p-0 @xl:grid-cols-5">
    {layers.map((l, i) => (
      <li class={`border-b border-vx-ink/20 p-5 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0 ${i === 1 ? 'bg-vx-mint' : ''}`}>
        <p class="mono text-xs text-vx-ink/60">{i + 1}</p>
        <p class="mt-2 font-bold">{l}</p>
        {i === 1 && <p class="mono mt-2 text-xs">◆ an example key resolved here</p>}
      </li>
    ))}
  </ol>

  <SubHead title="Local models">
      A model you run locally appears in <code class="mono">/model</code>. If you stop its server, it leaves
      the picker and stays in <code class="mono">/credentials</code>, so Belai won't switch to a host that
      isn't running.
    </SubHead>
  <p class="mt-head text-vx-ink/80">
    The <code class="mono">/model</code> screen fits one terminal screen: a rail of roles, a pane for the role you are editing, and a status line for the last test. Left and right change role, and each role names the file it saves to.
  </p>
  <div class="mt-8 grid gap-8 @4xl:grid-cols-12">
    <div class="min-w-0 @4xl:col-span-7">
      <Shot
        shot={localModelShot}
        title="/local-model assess"
        alt="A /local-model assess verdict showing the candidate, how well it fits and notes"
        rows={[2, 6]}
        marks={[{ row: 4, col: 22 }]}
        notes={['How well the candidate fits this machine, before you commit to it.']}
      />
    </div>
    <aside class="flex min-w-0 flex-col gap-5 @4xl:col-span-5">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">A SECOND OLLAMA IS ONE MORE ENTRY</p>
        <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm">
          {instanceKeys.map(([k, v]) => (
            <>
              <dt class="mono text-vx-mint">{k}</dt>
              <dd class="m-0 text-vx-cream/80">{v}</dd>
            </>
          ))}
        </dl>
        <p class="mt-3 text-sm text-vx-cream/75">
          <code class="mono">/providers</code>, <code class="mono">/model</code>, the footer and the{' '}
          <code class="mono">-provider</code> flag all accept the label.
        </p>
      </div>
      <div class="rounded-xl border border-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-ink/60">/local-model</p>
        <p class="mt-3">
          Runs the classifier probe against a local model before you use it for a session. It reports how
          well the model fits, any notes, and how it compares with the hosted baseline.
        </p>
      </div>
    </aside>
  </div>

  <SubHead title="The classifier's own rows">
      The <a href="#classifier" class="text-vx-ink underline">classifier</a> section explains how the
      engines combine, and <a href="#routing" class="text-vx-ink underline">model routing</a> covers which
      model answers every other kind of call.
    </SubHead>
  <table class="mt-8 w-full border-collapse text-left">
    <thead>
      <tr class="border-b-2 border-vx-ink">
        <th scope="col" class="mono w-[30%] pb-4 text-sm font-medium text-vx-ink/60 @2xl:w-[22%]">row in /model</th>
        <th scope="col" class="px-5 pb-4 pt-3 text-lg font-bold">What you choose</th>
      </tr>
    </thead>
    <tbody>
      {classifierRows.map(([row, what]) => (
        <tr class="border-b border-vx-ink/20 last:border-b-0">
          <th scope="row" class="py-5 pr-5 align-top font-semibold">{row === 'kind' ? <code class="mono">kind</code> : row}</th>
          <td class="px-5 py-5 align-top text-vx-ink/85">{split(what).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}</td>
        </tr>
      ))}
    </tbody>
  </table>
</SealedSection>
