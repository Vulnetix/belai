        <span class={`mono text-xs ${p.accent ? 'text-vx-ink/70' : 'text-vx-ink/60'}`}>{p.cmd}</span>
        <span class="text-xl font-bold text-vx-ink">{p.name} ↗</span>
        <span class="text-sm text-vx-ink/80">{p.what}</span>
      </a>
    ))}
  </div>
  <p class="mt-4 text-sm text-vx-ink/70">The scanners, the firewall and the MCP server are free for everyone.</p>
