---
import SealedSection from '../seal/SealedSection.astro';
import ComparisonTable from '../ui/ComparisonTable.tsx';
import pixFacepalm from '../../assets/pix/pix-facepalm.svg?raw';

const sealText =
  'Compared with other harnesses: a table of which features Claude Code, Codex, Cursor and Gemini CLI have. Each row can be checked against a public source, and the table does not rate the models.';
---

<SealedSection label="labs" sealText={sealText} id="labs">
  <div>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-start">
      <div class="min-w-0">
        <h2 class="text-3xl font-bold text-vx-ink">Compared with other harnesses.</h2>
        <p class="mt-4 max-w-[72ch] text-vx-ink/80">
          Claude Code, Codex, Cursor and Gemini CLI run very good models. This table compares the
          harnesses around those models, and only on whether each feature exists. It says nothing about
          the models themselves.
        </p>
        <p class="mt-3 max-w-[72ch] text-vx-ink/80">
          Each row can be checked against public documentation or source code. A dot means no public
          source was found either way when the table was written.
        </p>

        <div class="mt-8">
          <ComparisonTable client:load />
        </div>
      </div>

      <div class="hidden max-w-[220px] lg:block" aria-hidden="true">
        <Fragment set:html={pixFacepalm} />
      </div>
    </div>
  </div>
</SealedSection>