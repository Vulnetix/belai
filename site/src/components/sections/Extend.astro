---
import SealedSection from '../seal/SealedSection.astro';
import SectionHead from '../ui/SectionHead.astro';
import SubHead from '../ui/SubHead.astro';
import Ladder from '../ui/Ladder.astro';
import Limits from '../ui/Limits.astro';
import CopyButton from '../ui/CopyButton.tsx';
import zedLogo from '../../assets/editors/zed.svg';
import jetbrainsLogo from '../../assets/editors/jetbrains.svg';
import neovimLogo from '../../assets/editors/neovim.svg';
import emacsLogo from '../../assets/editors/emacs.svg';
import vscodeLogo from '../../assets/editors/vscode.svg';

// Extending Belai: hooks, skills, plugins and notifications, then the
// integrations (MCP, ACP, OpenTelemetry). Hook events come from docs/hooks.md.

const extendSeal =
  'Extend it yourself: hooks at eleven points with allow, deny and ask decisions that can only narrow; skills loaded by name and new ones drafted only with your approval; plugin packages of skills, hooks, prompts and agents, validated whole, pinned and namespaced; desktop notifications written from fixed templates. Hook and skill text is classified like any other untrusted result. Integrations: MCP servers from your own settings, with every tool named mcp__server__tool, asking before it runs and classified after, and in code mode reached only from inside a script as mcp.server.tool() with the same rules; belai acp for Zed, JetBrains IDEs, Neovim, Emacs and VS Code with the same gates as the CLI and a fail-closed trust check, and a setup tutorial for each editor; OpenTelemetry export of spans and metrics built from an attribute allowlist that cannot carry content.';

const docBase = 'https://github.com/Vulnetix/belai/blob/main/docs/';

const kinds = [
  { n: '01', name: 'Hooks', key: 'allow · deny · ask', lead: 'Your command runs at one of eleven points, reads the event as JSON on stdin, and may narrow what happens next.' },
  { n: '02', name: 'Skills', key: 'Skill · SkillDraft', lead: 'The model loads a skill by name. It can propose a new one, and nothing is written unless you approve the file.' },
  { n: '03', name: 'Plugins', key: 'belai plugin install', lead: 'Packages of skills, hooks, prompts and agent profiles, checked whole and loaded under their own names.' },
  { n: '04', name: 'Integrations', key: 'MCP · ACP · OTel', lead: 'MCP servers, editors over the Agent Client Protocol, and telemetry that carries facts only.' },
];

// From docs/hooks.md, roughly in the order they fire during a session.
const events = [
  ['session_start', 'the TUI starts, before the first frame', false],
  ['user_prompt_submit', 'a prompt is submitted, before any model call', true],
  ['pre_tool', 'before any tool call runs, after the permission rules', true],
  ['pre_edit', 'before a Write or Edit runs, after pre_tool', true],
  ['post_tool', 'after a tool call returns successfully', false],
  ['post_edit', 'after a Write or Edit succeeds, after post_tool', false],
  ['subagent_stop', 'an explore subagent finishes', false],
  ['notification', 'Belai is waiting on you', false],
  ['stop', 'a turn ends', false],
  ['pre_compact', 'before /compact or automatic compaction', false],
  ['session_end', 'the TUI exits', false],
] as const;

const decisions = [
  ['deny', 'withholds the call'],
  ['ask', 'raises the permission prompt'],
  ['allow', 'never skips an ask a rule demanded, and never overrides a deny'],
  ['anything else', 'a blocking hook that fails, times out or prints anything but a decision denies'],
];

const plugin = [
  ['fetch', 'a git URL pinned with #ref, or a directory. Git runs with hooks off and no submodules'],
  ['check', 'every skill, hook, prompt and agent profile, with the validator Belai uses for your own files'],
  ['confirm', 'a listing that names every hook command, installed only on your yes'],
  ['load', 'as plugin:name, so your own components and the built-ins keep their names'],
];

const install = 'belai plugin install https://github.com/you/your-plugin#v1.0.0';

const integrations = [
  {
    title: 'MCP servers',
    key: 'mcp__server__tool',
    body: 'Declare stdio or streamable HTTP servers in your global settings. Each tool appears as `mcp__server__tool`, asks before it runs unless a rule allows it, is never offered in plan mode, and its result is classified. In code mode no server definition is sent at all: a script finds tools with `mcp.list()` and calls them as `mcp.server.tool()`, under the same rules, and agent, plan and goal mode are unchanged. A repository cannot add, change or start a server.',
    doc: 'mcp.md',
  },
  {
    title: 'Editors over ACP',
    key: 'belai acp',
    body: '`belai acp` speaks the Agent Client Protocol, so Zed, JetBrains IDEs, Neovim, Emacs and VS Code can use Belai as their agent. Each session is built like a headless CLI session, so every gate applies, and a directory you have not trusted is refused. An image block in a prompt is accepted: it is checked and re-encoded by Belai, never fetched by address, and at most eight go with a prompt. With `tests.post_end` on, a completed goal runs the detected tests and streams the result to the editor, and a failing run starts a fix turn whose permission asks go to the editor. Setup for each editor is below.',
    doc: 'acp.md',
  },
  {
    title: 'OpenTelemetry, without content',
    key: 'spans · metrics',
    body: 'Point Belai at a collector and it exports turn and tool-call spans on the session trace, plus token, tool, classifier and hook metrics. Only allowlisted keys leave, and every value is reduced to identifier characters, so no prompt, argument, output or path can.',
    doc: 'telemetry.md',
  },
];

const limits = [
  ['Hooks come from your folder', 'Hooks load from your global hooks directory, and each command must resolve inside its own directory. A project has no way to add one.'],
  ['Hook bundles run what they carry', 'A bundle is a hook definition and its scripts, in the format other coding agents write. It reaches a machine only when you install it from your library, and each command must be a file in the bundle or a program you allowed by name in your own settings.'],
  ['Hook and skill text classifies', 'What a hook says to the model, and every skill the model loads, goes through the classifier like any other untrusted result.'],
  ['Skills by name', '`Skill` takes a name and loads only a registered skill, checked against its schema as it loads.'],
  ['Search finds names', '`ToolSearch` finds skills as well as tools and returns names only. With a decision backend, only the skills your request needs are listed, and it ranks what it finds.'],
  ['Drafting always asks', '`SkillDraft` asks on every call, even with the ask gate off, and writes exactly the file you saw.'],
  ['Plugins carry components only', 'A plugin holds skills, hooks, prompts and agent profiles. Its manifest has no key for providers, credentials, settings or permissions, and only you can install one.'],
  ['Notifications from templates', 'Notification text comes from fixed templates, so a repository cannot put words in front of you. `notify-send`, `osascript`, OSC 9 or 777, or the bell.'],
];

const zedJson = `{
  "agent_servers": {
    "Belai": {
      "type": "custom",
      "command": "belai",
      "args": ["acp"],
      "env": {}
    }
  }
}`;

const zedSteps = [
  ['Trust the folder', 'Open the project in the TUI once and accept the prompt, or run `belai -trust-dir` there. The prompt never runs over ACP, so an untrusted folder is refused at `session/new` with a message saying why.'],
  ['Register the agent', 'Add the entry to Zed\'s `settings.json` under `agent_servers`. Add `"-provider", "<name>", "-model", "<id>"` to `args` to pin a model, or leave them and Belai resolves one as the TUI does.'],
  ['Start a thread', 'Open the Agent Panel, choose Belai in the agent selector or new-thread menu, and prompt. The session starts in the open project folder. Bind a key to `agent: new external agent thread` if you want one.'],
  ['Read the protocol', 'Run `dev: open acp logs` from the command palette to see the messages between Zed and Belai. Belai writes only protocol messages to stdout, so its diagnostics are on stderr.'],
];

const zedStream = [
  ['agent_message_chunk', 'reply text as it streams'],
  ['agent_thought_chunk', 'reasoning'],
  ['tool_call', 'each call as it starts, tagged read, edit, search, execute, fetch or think'],
  ['tool_call_update', 'the file diff a call made, then its result'],
  ['plan', 'the goal-mode todo list'],
  ['session/request_permission', 'allow once, allow for this session, or reject'],
];

const clients = [
  { name: 'JetBrains IDEs', logo: jetbrainsLogo, doc: 'acp-jetbrains.md', body: 'Add Custom Agent in AI Chat opens `~/.jetbrains/acp.json`. Register `belai acp` there with an absolute path.' },
  { name: 'Neovim', logo: neovimLogo, doc: 'acp-neovim.md', body: 'ACP plugins such as CodeCompanion take `belai acp` as the command of a custom adapter.' },
  { name: 'Emacs', logo: emacsLogo, doc: 'acp-emacs.md', body: 'agent-shell runs `belai acp` as a custom agent from one `setq` in your init file.' },
  { name: 'VS Code', logo: vscodeLogo, doc: 'acp-vscode.md', body: 'An ACP client extension reads `belai acp` from its `acp.agents` setting and opens a chat panel.' },
];

const split = (s: string) => s.split('`').map((p, i) => ({ p, c: i % 2 === 1 }));
---

<SealedSection label="extend" sealText={extendSeal} id="extend">
  <SectionHead title="Extend it yourself" surfaces={['tui', 'acp', 'cli', 'self-hosted']}>
    The things people usually add to a coding agent by forking it are built in, and each one goes through
    the same checks as the rest of Belai.
  </SectionHead>

  <Ladder steps={kinds} cols={4} from="narrows what the session does" to="connects it to other tools" />

  <SubHead title="Hooks at eleven points">
    A hook runs your command at one point in a session. At the three marked points it can stop what
    comes next; at the others it only observes.
  </SubHead>
  <details class="deep deep--wide">
    <summary>The eleven hook points and what a decision does</summary>
    <div class="deep__body">
  <div class="mt-4 grid gap-8 @4xl:grid-cols-12">
    <ol class="m-0 min-w-0 list-none p-0 @4xl:col-span-7">
      {events.map(([name, when, blocks], i) => (
        <li class="grid grid-cols-[2rem_minmax(0,1fr)_auto] items-baseline gap-3 border-b border-vx-ink/15 py-2.5 last:border-b-0">
          <span class="mono text-xs text-vx-ink/70">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <code class="mono font-semibold">{name}</code>
            <span class="block text-sm text-vx-ink/70 sm:ml-3 @xl:inline">{when}</span>
          </span>
          {blocks ? <span class="mono rounded-md bg-vx-ink px-2 py-0.5 text-xs text-vx-mint">can block</span> : <span></span>}
        </li>
      ))}
    </ol>
    <aside class="flex min-w-0 flex-col gap-5 @4xl:col-span-5">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">WHAT A DECISION DOES</p>
        <dl class="mt-3 grid gap-y-3 text-sm">
          {decisions.map(([d, what]) => (
            <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-3">
              <dt class="mono text-vx-mint">{d}</dt>
              <dd class="m-0 text-vx-cream/80">{what}</dd>
            </div>
          ))}
        </dl>
      </div>
      <p class="text-sm text-vx-ink/75">
        A hook runs after the permission rules, so it can only narrow them. A project can turn hooks off,
        never on. A hook bundle follows the same rules, and its scripts install only on your yes. <a class="text-vx-ink underline" href={`${docBase}hooks.md`}>docs/hooks.md</a>
      </p>
    </aside>
  </div>
    </div>
  </details>

  <SubHead title="Skills, drafted with approval" surfaces={['tui']}>
    After working out a procedure worth keeping, the model can propose it as a skill with{' '}
    <code class="mono">SkillDraft</code>. You see the whole file, or the diff against an existing skill.
  </SubHead>
  <div class="mt-head grid gap-5 @2xl:grid-cols-3">
    <article class="rounded-xl border border-vx-ink p-5">
      <p class="mono text-xs text-vx-ink/60">01</p>
      <h4 class="mt-2 text-lg font-bold">Loaded by name</h4>
      <p class="mt-2 text-sm text-vx-ink/80">The model calls <code class="mono">Skill</code> with a name. Only a skill's name and description reach the system block, and only while <code class="mono">Skill</code> is on offer.</p>
    </article>
    <article class="rounded-xl border border-vx-ink p-5">
      <p class="mono text-xs text-vx-ink/60">02</p>
      <h4 class="mt-2 text-lg font-bold">Proposed as a file</h4>
      <p class="mt-2 text-sm text-vx-ink/80">A draft shows the whole <code class="mono">SKILL.md</code>, checked against the same front-matter schema as the skills you write.</p>
    </article>
    <article class="rounded-xl border border-vx-ink bg-vx-ink p-5 text-vx-cream">
      <p class="mono text-xs text-vx-cream/60">03</p>
      <h4 class="mt-2 text-lg font-bold">Written on your yes</h4>
      <p class="mt-2 text-sm text-vx-cream/80">Nothing is written unless you approve, and with nobody to ask the draft is withheld. <code class="mono text-vx-mint">/skills</code> lists what is installed.</p>
    </article>
  </div>

  <SubHead title="Plugin packages" surfaces={['cli', 'self-hosted']}>
    <code class="mono">belai plugin install</code> takes a git URL or a directory. One bad component fails
    the whole install, and <code class="mono">/plugin</code> shows what is installed and its state.
  </SubHead>
  <details class="deep deep--wide">
    <summary>The steps of an install, and the command</summary>
    <div class="deep__body">
  <div class="mt-4 grid gap-8 @4xl:grid-cols-12">
    <ol class="m-0 grid min-w-0 list-none gap-3 p-0 @xl:grid-cols-2 @4xl:col-span-8">
      {plugin.map(([step, what], i) => (
        <li class="rounded-xl border border-vx-ink p-5">
          <span class="mono text-xs text-vx-ink/60">{String(i + 1).padStart(2, '0')}</span>
          <p class="mono mt-2 text-lg font-semibold">{step}</p>
          <p class="mt-1 text-sm text-vx-ink/75">{what}</p>
        </li>
      ))}
    </ol>
    <aside class="flex min-w-0 flex-col gap-3 @4xl:col-span-4">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">INSTALL ONE</p>
        <pre class="mono mt-3 overflow-x-auto whitespace-pre-wrap break-all text-sm leading-7 text-vx-mint"><code>{install}</code></pre>
        <p class="mt-2 text-sm text-vx-cream/75">list, update, enable, disable and remove manage it later.</p>
      </div>
      <div><CopyButton value={install} label="copy command" client:visible /></div>
      <p class="text-sm"><a class="text-vx-ink underline" href={`${docBase}plugins.md`}>docs/plugins.md</a></p>
    </aside>
  </div>
    </div>
  </details>

  <SubHead id="integrations" title="Integrations">
    Belai connects to the tools and editors you already use, and each connection goes through the same
    gates as the session.
  </SubHead>
  <div class="mt-head grid gap-5 @3xl:grid-cols-3">
    {integrations.map((it, i) => (
      <article class={`flex flex-col rounded-xl border border-vx-ink p-6 ${i === 1 ? 'bg-vx-ink text-vx-cream' : ''}`}>
        <code class={`mono text-sm ${i === 1 ? 'text-vx-mint' : 'text-vx-mint-strong'}`}>{it.key}</code>
        <h4 class="mt-2 text-2xl font-bold">{it.title}</h4>
        <p class={`mt-3 flex-1 text-sm ${i === 1 ? 'text-vx-cream/80' : 'text-vx-ink/80'}`}>
          {split(it.body).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}
        </p>
        <a class={`mt-4 text-sm underline ${i === 1 ? 'text-vx-cream' : 'text-vx-ink'}`} href={`${docBase}${it.doc}`}>docs/{it.doc}</a>
      </article>
    ))}
  </div>

  <SubHead id="editors" title="Belai in your editor" surfaces={['acp']}>
    <code class="mono">belai acp</code> is an Agent Client Protocol agent on stdin and stdout. Zed is the
    reference setup below, and the other editors take the same command.
  </SubHead>
  <details class="deep deep--wide">
    <summary>Set up Zed, step by step</summary>
    <div class="deep__body">
  <div class="mt-4 grid gap-8 @4xl:grid-cols-12">
    <div class="min-w-0 @4xl:col-span-8">
      <div class="flex items-center gap-4">
        <img src={zedLogo.src} alt="Zed logo" class="size-10" width="40" height="40" loading="lazy" decoding="async" />
        <h4 class="text-2xl font-bold">Zed</h4>
      </div>
      <ol class="m-0 mt-5 grid list-none gap-3 p-0 @xl:grid-cols-2">
        {zedSteps.map(([step, what], i) => (
          <li class="rounded-xl border border-vx-ink p-5">
            <span class="mono text-xs text-vx-ink/60">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-2 text-lg font-bold">{step}</p>
            <p class="mt-1 text-sm text-vx-ink/75">
              {split(what).map(({ p, c }) => (c ? <code class="mono text-[0.92em]">{p}</code> : p))}
            </p>
          </li>
        ))}
      </ol>
      <p class="mt-5 max-w-[72ch] text-sm text-vx-ink/80">
        Permission asks appear in Zed's own prompt, and "allow for this session" covers one tool until the
        session ends. Zed's agent profiles and skills belong to Zed's agent, and Belai reads its own
        settings, skills and hooks. Sessions are alpha: they cannot be resumed from the TUI, clarifying
        questions are answered as declined, and images and audio are not accepted.
      </p>
      <p class="mt-3 text-sm">
        <a class="text-vx-ink underline" href={`${docBase}acp-zed.md`}>docs/acp-zed.md</a>
        <span class="text-vx-ink/60"> · </span>
        <a class="text-vx-ink underline" href="https://zed.dev/docs/ai/external-agents">Zed external agents</a>
      </p>
    </div>
    <aside class="flex min-w-0 flex-col gap-3 @4xl:col-span-4">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">ZED settings.json</p>
        <pre class="mono mt-3 overflow-x-auto text-sm leading-7 text-vx-mint"><code>{zedJson}</code></pre>
      </div>
      <div><CopyButton value={zedJson} label="copy settings" client:visible /></div>
      <div class="rounded-xl border border-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-ink/60">WHAT ZED RECEIVES</p>
        <dl class="mt-3 grid gap-y-2 text-sm">
          {zedStream.map(([k, what]) => (
            <div>
              <dt class="mono text-xs font-semibold">{k}</dt>
              <dd class="m-0 text-vx-ink/75">{what}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </div>
    </div>
  </details>

  <h4 class="mt-sub text-2xl font-bold">Other editors</h4>
  <div class="mt-5 grid gap-5 @xl:grid-cols-2 @4xl:grid-cols-4">
    {clients.map((c) => (
      <article class="flex flex-col rounded-xl border border-vx-ink p-5">
        <div class="flex h-10 items-center gap-3">
          <img src={c.logo.src} alt={`${c.name} logo`} class="max-h-10 w-auto max-w-[8rem]" height="40" loading="lazy" decoding="async" />
          {c.name !== 'JetBrains IDEs' && <span class="text-lg font-bold">{c.name}</span>}
        </div>
        <p class="mt-3 flex-1 text-sm text-vx-ink/80">
          {split(c.body).map(({ p, c: code }) => (code ? <code class="mono text-[0.92em]">{p}</code> : p))}
        </p>
        <a class="mt-4 text-sm text-vx-ink underline" href={`${docBase}${c.doc}`}>docs/{c.doc}</a>
      </article>
    ))}
  </div>

  <Limits items={limits} />
</SealedSection>
