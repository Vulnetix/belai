---
import SealedSection from '../seal/SealedSection.astro';

// Model routing as a ladder of three tiers, then a table of which model
// answers each of the nine use cases in defined and routed mode.

const sealText =
  'Model routing: the model you pick does the work, a fast tier answers one-token verdicts and drafts the goal contract, and routed mode lets Jev pick a model per use case from your candidate list, falling back to the main model when it cannot decide. The security classifier never follows the routing table. tab cycles defined and routed.';

const tiers = [
  {
    n: '01',
    name: 'Fast tier',
    key: 'on by default',
    lead: "The provider's own small model, on the same credentials, gives the one-token verdicts, names the session and drafts the goal contract.",
  },
  {
    n: '02',
    name: 'Your model',
    key: 'defined',
    lead: 'Answers everything the fast tier does not: the work, clarifying questions, compaction and the final report, since their output shapes the rest of the work.',
  },
  {
    n: '03',
    name: 'Routed',
    key: 'tab',
    lead: 'List candidate models for a use case. Jev scores them on the first call and Belai keeps the winner for the session, or falls back to your model.',
  },
];

const FAST = 'Fast tier';
const JEV = "Jev's pick from your candidates";
const uses: [string, string, string, string][] = [
  ['main', 'The work itself', 'Your model', JEV],
  ['clarify', 'Questions for you', 'Your model', JEV],
  ['compaction', 'Summarising a long session', 'Your model', JEV],
  ['mode_eval', 'Picking agent, plan or goal', FAST, `${FAST}, without Jev`],
  ['plan_eval · goal_eval · agent_eval', 'One-token verdicts', FAST, `${FAST}, without Jev`],
  ['goal_contract', "Drafting a goal's contract", FAST, `${FAST}, without Jev`],
  ['session_name', 'Naming the session', FAST, `${FAST}, without Jev`],
];

const fastModels = [
  ['Anthropic', 'claude-haiku-4-5'],
  ['OpenAI', 'gpt-5-mini'],
  ['Google', 'gemini-2.0-flash'],
  ['Groq · Mistral · xAI', 'a matching small model'],
];

const keys = [
  ['routing.kind', 'defined or routed'],
  ['routing.use_cases', 'the candidates per use case'],
  ['routing.fast_model', "another provider's small model"],
  ['classifier.tier', 'main or fast'],
];

const limits = [
  ['The classifier stays put', 'It follows classifier.tier and ignores the routing table. A smaller guard is easier to talk past, so moving it is your decision.'],
  ['Checked at load', 'A candidate needs a provider or a model, and the provider must be one Belai knows. A bad table stops startup instead of sending traffic somewhere unexpected.'],
  ['A call always gets an answer', 'A failed Jev call, a tie or a winner missing from your list falls back to your model. Routing can make a call slower, and that is all.'],
  ['Per project, key by key', "A project's settings can change one use case without repeating the global table."],
  ['Counted where served', 'Every routed or fast-tier call counts against the budget of the model that answered it.'],
  ['/model says what is in effect', 'The screen opens with four lines, resolved from the live settings: the work, the verdicts, the drafting and the security check.'],
];

---

<SealedSection label="routing" sealText={sealText} id="routing">
  <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <div class="lg:col-span-7">
      <h2 class="text-4xl font-extrabold leading-tight tracking-tight text-vx-ink md:text-5xl">Model routing</h2>
    </div>
    <p class="text-lg text-vx-ink/80 lg:col-span-5">
      A single prompt can make several model calls before the first edit, and most of them return one
      token. Routing sends those calls to a small model, so the model you picked is spent on the work.
    </p>
  </div>

  <ol class="mt-10 grid list-none gap-5 p-0 lg:grid-cols-3">
    {tiers.map((t, i) => {
      const dark = i === 2;
      return (
        <li class={`flex flex-col gap-4 rounded-xl border border-vx-ink p-6 ${dark ? 'bg-vx-ink text-vx-cream' : ''}`}>
          <div class="flex items-center justify-between">
            <span class={`mono text-sm ${dark ? 'text-vx-cream/70' : 'text-vx-ink/60'}`}>{t.n}</span>
            <kbd class={`mono rounded-md border border-b-[3px] px-2 py-0.5 text-sm ${dark ? 'border-vx-mint text-vx-mint' : 'border-vx-ink'}`}>{t.key}</kbd>
          </div>
          {i === 0 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="8" y="10" width="54" height="16" rx="4" />
              <rect x="8" y="34" width="54" height="16" rx="4" />
              <rect x="8" y="58" width="54" height="16" rx="4" />
              <rect x="8" y="82" width="54" height="16" rx="4" />
              <path d="M62 18 C 120 18, 120 54, 170 54 M62 42 L170 54 M62 66 L170 56 M62 90 C 120 90, 120 56, 170 56" stroke-dasharray="3 4" />
              <rect x="170" y="38" width="70" height="34" rx="8" class="fill-vx-mint" stroke="none" />
              <text x="188" y="60" font-family="Geist Mono, monospace" font-size="12" fill="currentColor" stroke="none">fast</text>
              <path d="M240 55 L300 55" />
              <text x="252" y="46" font-family="Geist Mono, monospace" font-size="11" fill="currentColor" stroke="none">1 token</text>
            </svg>
          )}
          {i === 1 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="100" y="14" width="120" height="82" rx="10" class="fill-vx-bone" />
              <path d="M118 36 H200 M118 52 H186 M118 68 H200 M118 84 H170" />
              <path d="M20 55 L100 55 M220 55 L300 55 M292 49 L301 55 L292 61" stroke-linejoin="round" />
            </svg>
          )}
          {i === 2 && (
            <svg viewBox="0 0 320 110" class="h-24 w-full text-vx-mint" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
              <g class="text-vx-cream/35" stroke="currentColor">
                <rect x="8" y="14" width="60" height="18" rx="4" />
                <rect x="8" y="46" width="60" height="18" rx="4" />
                <rect x="8" y="78" width="60" height="18" rx="4" />
              </g>
              <path d="M68 23 C 100 23, 100 55, 130 55 M68 55 L130 55 M68 87 C 100 87, 100 55, 130 55" stroke-dasharray="3 4" />
              <circle cx="150" cy="55" r="20" />
              <text x="137" y="60" font-family="Geist Mono, monospace" font-size="13" fill="currentColor" stroke="none">Jev</text>
              <path d="M170 55 L230 55" />
              <rect x="230" y="40" width="80" height="30" rx="6" class="fill-vx-mint" stroke="none" />
              <text x="244" y="60" font-family="Geist Mono, monospace" font-size="12" class="fill-vx-ink" stroke="none">winner</text>
              <path d="M150 75 L150 100 L270 100 L270 72" class="stroke-vx-sand-amber" stroke-dasharray="3 3" />
            </svg>
          )}
          <h3 class="text-2xl font-bold">{t.name}</h3>
          <p class={dark ? 'text-vx-cream/85' : 'text-vx-ink/80'}>{t.lead}</p>
        </li>
      );
    })}
  </ol>
  <div class="mono mt-3 hidden items-center gap-4 text-sm lg:flex" aria-hidden="true">
    <span class="text-vx-ink/60">one-token verdicts</span>
    <span class="h-px flex-1 bg-vx-ink"></span><span class="-ml-3">▸</span>
    <span>a model chosen per use case</span>
  </div>

  <div class="mt-20 grid gap-6 lg:grid-cols-2 lg:items-end">
    <h3 class="text-3xl font-bold tracking-tight text-vx-ink md:text-4xl">Who answers each call</h3>
    <p class="text-vx-ink/80">
      In chat or on <code class="mono">/model</code>, <code class="mono">tab</code> switches between defined
      and routed. The footer then shows the one model in use, or how many models the router has active.
    </p>
  </div>

  <table class="mt-8 hidden w-full border-collapse text-left md:table">
    <thead>
      <tr class="border-b-2 border-vx-ink">
        <th scope="col" class="mono w-[26%] pb-4 text-sm font-medium text-vx-ink/60">use case</th>
        <th scope="col" class="px-5 pb-4 pt-3 text-lg font-bold">The call</th>
        <th scope="col" class="px-5 pb-4 pt-3 text-lg font-bold">defined</th>
        <th scope="col" class="bg-vx-sand px-5 pb-4 pt-3 text-lg font-bold">routed</th>
      </tr>
    </thead>
    <tbody>
      {uses.map(([id, call, defined, routed]) => (
        <tr class="border-b border-vx-ink/20">
          <th scope="row" class="py-4 pr-5 align-top font-normal"><code class="mono text-[0.92em]">{id}</code></th>
          <td class="px-5 py-4 align-top text-vx-ink/85">{call}</td>
          <td class={`px-5 py-4 align-top ${defined === FAST ? 'font-semibold text-vx-mint-strong' : ''}`}>{defined}</td>
          <td class={`bg-vx-sand/40 px-5 py-4 align-top ${routed.startsWith(FAST) ? 'font-semibold text-vx-mint-strong' : ''}`}>{routed}</td>
        </tr>
      ))}
      <tr>
        <th scope="row" class="py-4 pr-5 align-top font-semibold">security classifier</th>
        <td class="px-5 py-4 align-top text-vx-ink/85">Checking untrusted content</td>
        <td colspan="2" class="px-5 py-4 align-top">
          Not routed. Your model or your classifier models answer, unless you set{' '}
          <code class="mono">classifier.tier</code> to <code class="mono">fast</code> yourself
        </td>
      </tr>
    </tbody>
  </table>

  <dl class="mt-8 grid gap-3 md:hidden">
    {uses.map(([id, call, defined, routed]) => (
      <div class="rounded-xl border border-vx-ink p-4 text-sm">
        <dt><code class="mono font-semibold">{id}</code> <span class="text-vx-ink/70">{call}</span></dt>
        <dd class="m-0 mt-2 grid grid-cols-[4.5rem_minmax(0,1fr)] gap-x-3 gap-y-1">
          <span class="mono text-vx-ink/60">defined</span><span>{defined}</span>
          <span class="mono text-vx-ink/60">routed</span><span>{routed}</span>
        </dd>
      </div>
    ))}
    <div class="rounded-xl bg-vx-ink p-4 text-sm text-vx-cream">
      <dt class="font-semibold">security classifier</dt>
      <dd class="m-0 mt-2 text-vx-cream/85">Not routed, unless you set <code class="mono">classifier.tier</code> to <code class="mono">fast</code></dd>
    </div>
  </dl>

  <div class="mt-20 grid gap-6 lg:grid-cols-2 lg:items-end">
    <h3 class="text-3xl font-bold tracking-tight text-vx-ink md:text-4xl">When Jev cannot decide</h3>
    <p class="text-vx-ink/80">
      On the first call for a use case, the Jev Decisions API scores your candidates. Anything short of
      a clear winner from your own list ends on your model.
    </p>
  </div>

  <div class="mt-8 grid gap-8 lg:grid-cols-12">
    <div class="min-w-0 rounded-xl border border-vx-ink bg-vx-bone/40 p-5 md:p-7 lg:col-span-8">
      <svg viewBox="0 0 720 260" class="h-auto w-full" fill="none" stroke="currentColor" stroke-width="1.5" role="img" aria-label="The first call for a use case goes to Jev. A winner from your list is kept for the session. A failed call, a tie or a winner not in your list falls back to your model.">
        <rect x="10" y="100" width="150" height="56" rx="10" class="fill-vx-cream" />
        <text x="26" y="124" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">first call for</text>
        <text x="26" y="144" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">a use case</text>
        <path d="M160 128 L250 128 M242 122 L251 128 L242 134" stroke-linejoin="round" />
        <circle cx="296" cy="128" r="44" class="fill-vx-ink" stroke="none" />
        <text x="282" y="124" font-family="Geist Mono, monospace" font-size="14" class="fill-vx-mint" stroke="none">Jev</text>
        <text x="272" y="142" font-family="Geist Mono, monospace" font-size="11" class="fill-vx-cream" stroke="none">scores</text>
        <path d="M340 110 C 400 110, 410 50, 470 50 M462 44 L471 50 L462 56" stroke-linejoin="round" />
        <rect x="472" y="24" width="238" height="52" rx="10" class="fill-vx-mint" stroke="none" />
        <text x="488" y="48" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">a winner from your list</text>
        <text x="488" y="66" font-family="Geist Mono, monospace" font-size="12" fill="currentColor" stroke="none">kept for the session</text>
        <path d="M340 146 C 400 146, 410 206, 470 206" stroke="#B86E00" stroke-dasharray="4 4" />
        <path d="M462 200 L471 206 L462 212" stroke="#B86E00" stroke-linejoin="round" />
        <rect x="472" y="170" width="238" height="72" rx="10" class="fill-vx-sand" stroke="none" />
        <text x="488" y="194" font-family="Geist, sans-serif" font-size="15" font-weight="700" fill="currentColor" stroke="none">your model answers</text>
        <text x="488" y="214" font-family="Geist Mono, monospace" font-size="12" fill="currentColor" stroke="none">a failed call, a tie, or</text>
        <text x="488" y="230" font-family="Geist Mono, monospace" font-size="12" fill="currentColor" stroke="none">a winner not in your list</text>
      </svg>
      <div class="mt-5 grid grid-cols-2 gap-4 border-t border-vx-ink/20 pt-4 md:grid-cols-4">
        {fastModels.map(([provider, model]) => (
          <div>
            <p class="mono text-xs text-vx-ink/60">{provider}</p>
            <p class={`mt-1 text-sm font-semibold ${model.includes(' ') ? '' : 'mono'}`}>{model}</p>
          </div>
        ))}
      </div>
      <p class="mt-3 text-sm text-vx-ink/70">
        The fast tier for each provider, on the credentials you already use.{' '}
        <code class="mono">routing.fast_model</code> can point it at another provider.
      </p>
    </div>
    <aside class="flex min-w-0 flex-col gap-5 lg:col-span-4">
      <div class="rounded-xl bg-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-cream/70">FOUR SETTINGS</p>
        <dl class="mono mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-[13px]">
          {keys.map(([k, v]) => (
            <>
              <dt class="text-vx-mint">{k}</dt>
              <dd class="m-0 text-vx-cream/80">{v}</dd>
            </>
          ))}
        </dl>
      </div>
      <div class="rounded-xl border border-vx-ink p-5">
        <p class="mono text-xs tracking-wider text-vx-ink/60">/model OPENS ON FOUR LINES</p>
        <ul class="mt-3 list-none space-y-1 p-0">
          <li>which model does the work</li>
          <li>which gives the verdicts</li>
          <li>which drafts</li>
          <li>which runs the security check</li>
        </ul>
      </div>
    </aside>
  </div>

  <div class="mt-20 grid gap-6 lg:grid-cols-2 lg:items-end">
    <h3 class="text-3xl font-bold tracking-tight text-vx-ink md:text-4xl">Limits on routing</h3>
    <p class="text-vx-ink/80">
      Routing changes what a session costs and how fast it answers. The security check stays where you
      put it.
    </p>
  </div>
  <div class="mt-8 grid border-t-2 border-vx-ink md:grid-cols-2 xl:grid-cols-3">
    {limits.map(([title, body]) => (
      <div class="border-b border-vx-ink/20 py-6 md:pr-8">
        <h4 class="text-lg font-bold">{title}</h4>
        <p class="mt-2 text-sm text-vx-ink/80">
          {body.split(/(classifier\.tier)/).map((p) => (p === 'classifier.tier' ? <code class="mono">{p}</code> : p))}
        </p>
      </div>
    ))}
  </div>
</SealedSection>
